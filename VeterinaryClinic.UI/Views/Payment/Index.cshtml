    <script>

        /* =========================================================
           PAYMENT CREATE
           ========================================================= */

        function goToPaymentCreate(appointmentId) {

            if (appointmentId) {

                // Daha sonra gerçek MVC route'una çevireceğiz.
                window.location.href =
                    "/Payment/Create?appointmentId=" + appointmentId;

                return;
            }

            window.location.href = "/Payment/Create";
        }



        /* =========================================================
           OUTSTANDING PAYMENT SEARCH
           ========================================================= */

        const outstandingSearch =
            document.getElementById("outstandingSearch");

        const outstandingTable =
            document.getElementById("outstandingTable");

        const outstandingEmpty =
            document.getElementById("outstandingEmpty");


        function filterOutstandingPayments() {

            const searchValue =
                outstandingSearch.value
                    .toLowerCase()
                    .trim();


            const rows =
                outstandingTable.querySelectorAll("tr");


            let visibleCount = 0;


            rows.forEach(row => {

                const name =
                    row.dataset.name.toLowerCase();


                const matchesSearch =
                    name.includes(searchValue);


                if (matchesSearch) {

                    row.style.display = "";

                    visibleCount++;

                } else {

                    row.style.display = "none";

                }

            });


            if (visibleCount === 0) {

                outstandingEmpty.style.display = "block";

            } else {

                outstandingEmpty.style.display = "none";

            }

        }


        outstandingSearch.addEventListener(
            "input",
            filterOutstandingPayments
        );



        /* =========================================================
           REMAINING PAYMENT FILTER
           ========================================================= */

        const outstandingMethodFilter =
            document.getElementById(
                "outstandingMethodFilter"
            );


        outstandingMethodFilter.addEventListener(
            "change",
            function () {

                const value = this.value;

                const rows =
                    outstandingTable.querySelectorAll("tr");


                let visibleCount = 0;


                rows.forEach(row => {

                    const remaining =
                        Number(row.dataset.remaining);


                    let show = true;


                    if (value === "high") {

                        show = remaining >= 700;

                    }


                    if (value === "low") {

                        show = remaining < 700;

                    }


                    if (show) {

                        row.style.display = "";

                        visibleCount++;

                    } else {

                        row.style.display = "none";

                    }

                });


                if (visibleCount === 0) {

                    outstandingEmpty.style.display = "block";

                } else {

                    outstandingEmpty.style.display = "none";

                }

            }
        );



        /* =========================================================
           DATE RANGE
           ========================================================= */

        const dateRange =
            document.getElementById("dateRange");


        dateRange.addEventListener(
            "change",
            function () {

                console.log(
                    "Seçilen tarih aralığı:",
                    this.value
                );

            }
        );

    </script>
