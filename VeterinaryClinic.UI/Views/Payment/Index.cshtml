@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (User.IsInRole("Manager"))
{
    <style>

        /* =========================================================
                   PAYMENT PAGE
                   ========================================================= */

        :root {
            --color-primary: #6C63A8;
            --color-primary-dark: #554C91;
            --color-primary-light: #F0EEFF;
            --color-secondary: #8FC9B5;
            --color-secondary-light: #EAF8F2;
            --color-accent: #F3B7A5;
            --color-accent-light: #FFF0EC;
            --color-success: #71B58A;
            --color-success-light: #EAF7EF;
            --color-warning: #E8B86A;
            --color-warning-light: #FFF7E8;
            --color-danger: #DF7C89;
            --color-danger-light: #FFF0F2;
            --color-info: #7FAFD0;
            --color-info-light: #EDF6FC;
            --color-background: #F8F7FC;
            --color-surface: #FFFFFF;
            --color-surface-alt: #F7F7FB;
            --color-text: #303044;
            --color-muted: #7B7B90;
            --color-border: #E9E8F0;
            --color-border-strong: #DCD9E8;
            --radius-sm: 8px;
            --radius-md: 12px;
            --radius-lg: 16px;
            --radius-xl: 20px;
            --shadow-sm: 0 2px 10px rgba(48, 48, 68, 0.04);
            --shadow-md: 0 8px 30px rgba(48, 48, 68, 0.06);
            --transition-fast: 0.2s ease;
        }


        /* =========================================================
                   BASE
                   ========================================================= */

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: var(--color-background);
            color: var(--color-text);
            font-family: 'Poppins', sans-serif;
            font-size: 14px;
        }

        button,
        input,
        select {
            font-family: inherit;
        }

        button {
            cursor: pointer;
        }

        a {
            text-decoration: none;
        }


        /* =========================================================
                   PAGE
                   ========================================================= */

        .payment-kpi-growth {
            padding: 4px 7px;
            border-radius: 7px;
            background: var(--color-success-light);
            color: #3B9965;
            font-weight: 600;
        }


        .payment-kpi-growth--positive {
            background: #EAF7EF !important;
            color: #71B58A !important;
        }

        .payment-kpi-growth--neutral {
            background: #F0F0F3 !important;
            color: #858594 !important;
        }

        .payment-kpi-growth--negative {
            background: #FFF0F2 !important;
            color: #DF7C89 !important;
        }


        /* =========================================================
                   HEADER
                   ========================================================= */

        .payment-page-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 24px;
        }

        .payment-page-header-left {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .payment-page-header-icon {
            width: 54px;
            height: 54px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--color-primary-light);
            color: var(--color-primary);
            font-size: 22px;
        }

        .payment-page-title {
            margin: 0;
            font-size: 1.65rem;
            font-weight: 700;
            color: var(--color-text);
            letter-spacing: -0.02em;
        }

        .payment-page-subtitle {
            margin: 3px 0 0;
            color: var(--color-muted);
            font-size: 0.82rem;
        }

        .payment-page-header-actions {
            display: flex;
            align-items: center;
            gap: 12px;
        }


        /* =========================================================
                   BUTTONS
                   ========================================================= */

        .payment-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            border: 1px solid transparent;
            border-radius: var(--radius-md);
            padding: 11px 17px;
            font-size: 0.82rem;
            font-weight: 600;
            transition: background-color var(--transition-fast), border-color var(--transition-fast), color var(--transition-fast), transform var(--transition-fast);
        }

            .payment-btn:active {
                transform: scale(0.98);
            }

        .payment-btn-primary {
            background: var(--color-primary);
            color: white;
        }

            .payment-btn-primary:hover {
                background: var(--color-primary-dark);
                color: white;
            }

        .payment-btn-outline {
            background: white;
            border-color: var(--color-border-strong);
            color: var(--color-text);
        }

            .payment-btn-outline:hover {
                background: var(--color-primary-light);
                border-color: var(--color-primary);
                color: var(--color-primary-dark);
            }

        .payment-btn-small {
            padding: 8px 12px;
            font-size: 0.74rem;
            border-radius: 9px;
        }


        /* =========================================================
                   DATE SELECT
                   ========================================================= */

        .payment-date-select {
            height: 42px;
            min-width: 190px;
            border: 1px solid var(--color-border-strong);
            border-radius: var(--radius-md);
            background: white;
            color: var(--color-text);
            padding: 0 13px;
            outline: none;
            font-size: 0.78rem;
            font-weight: 500;
        }

            .payment-date-select:focus {
                border-color: var(--color-primary);
            }


        /* =========================================================
                   KPI CARDS
                   ========================================================= */

        .payment-kpi-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 14px;
            margin-bottom: 16px;
        }

        .payment-kpi-card {
            position: relative;
            overflow: hidden;
            background: var(--color-surface);
            border: 1px solid var(--color-border);
            border-radius: var(--radius-lg);
            padding: 20px;
            box-shadow: var(--shadow-sm);
        }

            .payment-kpi-card::after {
                content: "";
                position: absolute;
                right: -25px;
                bottom: -35px;
                width: 100px;
                height: 100px;
                border-radius: 50%;
                opacity: 0.45;
            }

            .payment-kpi-card.green::after {
                background: var(--color-secondary-light);
            }

            .payment-kpi-card.blue::after {
                background: var(--color-info-light);
            }

            .payment-kpi-card.purple::after {
                background: var(--color-primary-light);
            }

            .payment-kpi-card.orange::after {
                background: var(--color-warning-light);
            }

        .payment-kpi-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
        }

        .payment-kpi-icon {
            width: 42px;
            height: 42px;
            border-radius: 13px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 17px;
        }

        .payment-kpi-card.green .payment-kpi-icon {
            background: var(--color-secondary-light);
            color: #2CA879;
        }

        .payment-kpi-card.blue .payment-kpi-icon {
            background: var(--color-info-light);
            color: #428BD5;
        }

        .payment-kpi-card.purple .payment-kpi-icon {
            background: var(--color-primary-light);
            color: var(--color-primary);
        }

        .payment-kpi-card.orange .payment-kpi-icon {
            background: var(--color-warning-light);
            color: #E09132;
        }

        .payment-kpi-label {
            margin-top: 13px;
            color: var(--color-muted);
            font-size: 0.76rem;
            font-weight: 500;
        }

        .payment-kpi-value {
            margin-top: 3px;
            font-size: 1.32rem;
            font-weight: 700;
            letter-spacing: -0.02em;
        }

        .payment-kpi-bottom {
            display: flex;
            align-items: center;
            gap: 7px;
            margin-top: 10px;
            font-size: 0.68rem;
        }

        .payment-kpi-growth {
            padding: 4px 7px;
            border-radius: 7px;
            background: var(--color-success-light);
            color: #3B9965;
            font-weight: 600;
        }

        .payment-kpi-description {
            color: var(--color-muted);
        }

        .payment-kpi-card.orange .payment-kpi-growth {
            background: var(--color-warning-light);
            color: #C78526;
        }


        /* =========================================================
                   COMMON CARD
                   ========================================================= */

        .payment-card {
            background: var(--color-surface);
            border: 1px solid var(--color-border);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-sm);
        }

        .payment-card-header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 15px;
            padding: 19px 20px 0;
        }

        .payment-card-title {
            margin: 0;
            font-size: 0.94rem;
            font-weight: 700;
        }

        .payment-card-description {
            margin: 4px 0 0;
            color: var(--color-muted);
            font-size: 0.7rem;
        }


        /* =========================================================
                   MAIN TWO COLUMN
                   ========================================================= */

        .payment-main-grid {
            display: grid;
            grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
            gap: 16px;
            margin-bottom: 16px;
        }


        /* =========================================================
                   MONTHLY CHART
                   ========================================================= */

        .payment-chart-card {
            min-height: 315px;
        }

        .payment-bar-chart {
            height: 225px;
            padding: 25px 20px 18px;
            display: flex;
            align-items: flex-end;
            gap: 18px;
            border-bottom: 1px solid var(--color-border);
        }

        .payment-chart-column {
            flex: 1;
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            align-items: center;
            gap: 8px;
        }

        .payment-chart-value {
            font-size: 0.64rem;
            font-weight: 600;
            color: var(--color-text);
        }

        .payment-chart-bar-wrapper {
            height: 165px;
            width: 100%;
            display: flex;
            align-items: flex-end;
            justify-content: center;
        }

        .payment-chart-bar {
            width: 52px;
            max-width: 80%;
            border-radius: 8px 8px 3px 3px;
            background: var(--color-secondary);
            transition: height 0.5s ease, transform var(--transition-fast);
        }

            .payment-chart-bar:hover {
                transform: translateY(-4px);
            }

        .payment-chart-month {
            font-size: 0.64rem;
            color: var(--color-muted);
        }


        /* =========================================================
                   DONUT CHART
                   ========================================================= */

        .payment-method-layout {
            display: grid;
            grid-template-columns: 190px 1fr;
            align-items: center;
            gap: 10px;
            min-height: 260px;
            padding: 20px;
        }

        .payment-donut {
            position: relative;
            width: 175px;
            height: 175px;
            margin: 0 auto;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .payment-donut::after {
                content: "";
                width: 112px;
                height: 112px;
                border-radius: 50%;
                background: white;
            }

        .payment-donut-content {
            position: absolute;
            z-index: 2;
            text-align: center;
        }

        .payment-donut-total {
            font-size: 1rem;
            font-weight: 700;
        }

        .payment-donut-label {
            margin-top: 2px;
            color: var(--color-muted);
            font-size: 0.62rem;
        }

        .payment-method-list {
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .payment-method-item {
            display: grid;
            grid-template-columns: 10px minmax(0, 1fr) auto auto;
            gap: 9px;
            align-items: center;
        }

        .payment-method-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
        }

        .payment-method-name {
            font-size: 0.72rem;
            color: var(--color-text);
        }

        .payment-method-percent {
            font-size: 0.7rem;
            font-weight: 600;
        }

        .payment-method-amount {
            font-size: 0.7rem;
            color: var(--color-muted);
            min-width: 75px;
            text-align: right;
        }


        /* =========================================================
                   SECOND ROW
                   ========================================================= */

        .payment-second-grid {
            display: grid;
            grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
            gap: 16px;
            margin-bottom: 16px;
        }


        /* =========================================================
                   REVENUE BY TYPE
                   ========================================================= */

        .payment-revenue-list {
            display: flex;
            flex-direction: column;
            gap: 18px;
            padding: 20px;
        }

        .payment-revenue-item {
            display: grid;
            grid-template-columns: 155px minmax(0, 1fr) 85px;
            gap: 12px;
            align-items: center;
        }

        .payment-revenue-label {
            display: flex;
            align-items: center;
            gap: 9px;
            font-size: 0.72rem;
            font-weight: 500;
        }

        .payment-revenue-icon {
            width: 28px;
            height: 28px;
            border-radius: 9px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--color-primary-light);
            color: var(--color-primary);
            font-size: 11px;
        }

        .payment-progress {
            height: 9px;
            overflow: hidden;
            border-radius: 20px;
            background: #ECEBF2;
        }

        .payment-progress-bar {
            height: 100%;
            border-radius: inherit;
        }

        .payment-revenue-value {
            text-align: right;
            font-size: 0.72rem;
            font-weight: 600;
        }


        /* =========================================================
                   TOP CUSTOMERS
                   ========================================================= */

        .payment-customer-list {
            padding: 8px 20px 14px;
        }

        .payment-customer-row {
            display: grid;
            grid-template-columns: 28px 38px minmax(0, 1fr) auto;
            align-items: center;
            gap: 10px;
            padding: 10px 0;
            border-bottom: 1px solid var(--color-border);
        }

            .payment-customer-row:last-child {
                border-bottom: none;
            }

        .payment-customer-rank {
            width: 27px;
            height: 27px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--color-surface-alt);
            color: var(--color-muted);
            font-size: 0.66rem;
            font-weight: 600;
        }

            .payment-customer-rank.first {
                background: var(--color-warning-light);
                color: #D18B28;
            }

        .payment-customer-avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--color-primary-light);
            color: var(--color-primary);
            font-weight: 600;
            font-size: 0.8rem;
        }

        .payment-customer-name {
            font-size: 0.74rem;
            font-weight: 600;
        }

        .payment-customer-count {
            margin-top: 2px;
            color: var(--color-muted);
            font-size: 0.61rem;
        }

        .payment-customer-total {
            font-size: 0.72rem;
            font-weight: 700;
        }


        /* =========================================================
                   THIRD ROW
                   ========================================================= */

        .payment-third-grid {
            display: grid;
            grid-template-columns: minmax(0, 1.7fr) minmax(280px, 0.8fr);
            gap: 16px;
            margin-bottom: 16px;
        }


        /* =========================================================
                   RECENT PAYMENTS
                   ========================================================= */

        .payment-table-wrapper {
            overflow-x: auto;
            padding: 15px 20px 20px;
        }

        .payment-table {
            width: 100%;
            border-collapse: collapse;
            min-width: 700px;
        }

            .payment-table th {
                padding: 10px 8px;
                background: var(--color-surface-alt);
                color: var(--color-muted);
                text-align: left;
                font-size: 0.62rem;
                font-weight: 600;
                white-space: nowrap;
            }

                .payment-table th:first-child {
                    border-radius: 8px 0 0 8px;
                }

                .payment-table th:last-child {
                    border-radius: 0 8px 8px 0;
                }

            .payment-table td {
                padding: 11px 8px;
                border-bottom: 1px solid var(--color-border);
                font-size: 0.68rem;
                vertical-align: middle;
            }

            .payment-table tr:last-child td {
                border-bottom: none;
            }

        .payment-animal {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .payment-animal-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            overflow: hidden;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .payment-animal-avatar img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .payment-animal-name {
            font-weight: 600;
        }

        .payment-owner {
            color: var(--color-muted);
        }

        .payment-amount {
            font-weight: 700;
        }

        .payment-method-badge {
            display: inline-flex !important;
            flex-direction: row !important;
            align-items: center !important;
            justify-content: center !important;
            gap: 6px;
            white-space: nowrap !important;
            width: 85px !important;
        }

        .payment-table th:last-child,
        .payment-table td:last-child {
            min-width: 130px;
        }

        .payment-method-badge.card {
            background: #F0EDFF;
            color: #6C63A8;
        }

        .payment-method-badge.cash {
            background: #EAF7EF;
            color: #71B58A;
        }

        .payment-method-badge.transfer {
            background: #EEF6FC;
            color: #5D9BEF;
        }

        .payment-method-badge.other {
            background: #FFF0EC;
            color: #D6816B;
        }


        /* =========================================================
                   FINANCIAL SUMMARY
                   ========================================================= */

        .payment-summary-list {
            padding: 15px 20px 20px;
        }

        .payment-summary-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 13px 10px;
            border-bottom: 1px solid var(--color-border);
        }

            .payment-summary-item:last-child {
                border-bottom: none;
            }

        .payment-summary-left {
            display: flex;
            align-items: center;
            gap: 9px;
        }

        .payment-summary-icon {
            width: 30px;
            height: 30px;
            border-radius: 9px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--color-surface-alt);
            color: var(--color-muted);
            font-size: 11px;
        }

        .payment-summary-label {
            font-size: 0.68rem;
        }

        .payment-summary-value {
            font-size: 0.72rem;
            font-weight: 700;
        }

        .payment-summary-item.danger .payment-summary-icon {
            background: var(--color-danger-light);
            color: var(--color-danger);
        }

        .payment-summary-item.danger .payment-summary-label,
        .payment-summary-item.danger .payment-summary-value {
            color: #C95F6D;
        }

        .payment-summary-item.success .payment-summary-icon {
            background: var(--color-success-light);
            color: var(--color-success);
        }


        /* =========================================================
                   OUTSTANDING PAYMENTS
                   ========================================================= */

        .payment-outstanding-card {
            margin-top: 0;
        }

        .payment-outstanding-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 19px 20px 5px;
        }

        .payment-outstanding-title-wrapper {
            display: flex;
            align-items: center;
            gap: 11px;
        }

        .payment-outstanding-icon {
            width: 36px;
            height: 36px;
            border-radius: 11px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--color-danger-light);
            color: var(--color-danger);
            font-size: 14px;
        }

        .payment-outstanding-title {
            margin: 0;
            font-size: 0.94rem;
            font-weight: 700;
        }

        .payment-outstanding-subtitle {
            margin: 3px 0 0;
            color: var(--color-muted);
            font-size: 0.68rem;
        }

        .payment-outstanding-link {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            color: var(--color-primary);
            font-size: 0.68rem;
            font-weight: 600;
        }

            .payment-outstanding-link:hover {
                color: var(--color-primary-dark);
            }

        .payment-outstanding-table-wrapper {
            overflow-x: auto;
            padding: 15px 20px 20px;
        }

        .payment-outstanding-table {
            width: 100%;
            border-collapse: collapse;
            min-width: 900px;
        }

            .payment-outstanding-table th {
                padding: 11px 8px;
                background: var(--color-surface-alt);
                color: var(--color-muted);
                text-align: left;
                font-size: 0.62rem;
                font-weight: 600;
            }

                .payment-outstanding-table th:first-child {
                    border-radius: 8px 0 0 8px;
                }

                .payment-outstanding-table th:last-child {
                    border-radius: 0 8px 8px 0;
                }

            .payment-outstanding-table td {
                padding: 12px 8px;
                border-bottom: 1px solid var(--color-border);
                font-size: 0.67rem;
                vertical-align: middle;
            }

            .payment-outstanding-table tr:last-child td {
                border-bottom: none;
            }

        .outstanding-animal {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .outstanding-avatar {
            width: 34px;
            height: 34px;
            border-radius: 9px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--color-accent-light);
            color: #D6816B;
        }

        .outstanding-animal-name {
            font-weight: 600;
        }

        .outstanding-owner {
            color: var(--color-muted);
        }

        .outstanding-treatment {
            font-weight: 500;
        }

        .outstanding-total {
            font-weight: 600;
        }

        .outstanding-paid {
            color: var(--color-success);
            font-weight: 600;
        }

        .outstanding-remaining {
            color: var(--color-danger);
            font-weight: 700;
        }

        .outstanding-appointment {
            color: var(--color-primary);
            font-weight: 600;
        }


        /* =========================================================
                   EMPTY STATE
                   ========================================================= */

        .payment-empty {
            display: none;
            padding: 35px 20px;
            text-align: center;
            color: var(--color-muted);
        }

            .payment-empty i {
                display: block;
                margin-bottom: 10px;
                font-size: 25px;
                color: var(--color-border-strong);
            }


        /* =========================================================
                   SEARCH / FILTER
                   ========================================================= */

        .payment-filter-area {
            display: flex;
            align-items: center;
            gap: 9px;
        }

        .payment-search {
            position: relative;
        }

            .payment-search i {
                position: absolute;
                left: 11px;
                top: 50%;
                transform: translateY(-50%);
                color: var(--color-muted);
                font-size: 12px;
            }

            .payment-search input {
                width: 190px;
                height: 37px;
                padding: 0 10px 0 31px;
                border: 1px solid var(--color-border);
