<!-- =============================================================
     JAVASCRIPT
============================================================== -->

<script>

    document.addEventListener("DOMContentLoaded", function () {

        /* =====================================================
           PAYMENT VALUES
        ====================================================== */

        const totalTreatmentAmount = parseFloat(document.getElementById("totalTreatmentAmount").textContent);

        const alreadyPaidAmount = parseFloat(document.getElementById("alreadyPaidAmount").textContent);

        let remainingAmount = Math.max(0, totalTreatmentAmount - alreadyPaidAmount);



        /* =====================================================
           ELEMENTS
        ====================================================== */

        const paymentAmount =
            document.getElementById("paymentAmount");
        paymentAmount.max = remainingAmount;

        const paymentAmountValue =
            document.getElementById("paymentAmountValue");
        if (paymentAmountValue) {
            paymentAmountValue.textContent =
                remainingAmount.toLocaleString("tr-TR", {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                });
        }
        const remainingAmountElement =
            document.getElementById("remainingAmount");

        const paymentProgress =
            document.getElementById("paymentProgress");

        const paidPercentage =
            document.getElementById("paidPercentage");

        const remainingPercentage =
            document.getElementById("remainingPercentage");

        const submitPayment =
            document.getElementById("submitPayment");

        const paymentForm =
            document.getElementById("paymentForm");

        const paymentNote =
            document.getElementById("paymentNote");

        const noteCounter =
            document.getElementById("noteCounter");


        /* =====================================================
           FORMAT MONEY
        ====================================================== */

        function formatMoney(value) {

            return value.toLocaleString("tr-TR", {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            }) + " ₺";

        }


        /* =====================================================
           UPDATE PAYMENT SUMMARY
        ====================================================== */

        function updatePaymentSummary() {

            const currentPayment =
                parseFloat(paymentAmount.value) || 0;


            const newRemaining =
                Math.max(
                    0,
                    remainingAmount - currentPayment
                );


            const newPaid =
                alreadyPaidAmount + currentPayment;


            const paidPercent =
                totalTreatmentAmount === 0
                    ? 0
                    : (newPaid / totalTreatmentAmount) * 100;


            const remainingPercent =
                100 - paidPercent;


            remainingAmountElement.textContent =
                formatMoney(newRemaining);


            paymentProgress.style.width =
                Math.min(100, Math.max(0, paidPercent)) + "%";


            paidPercentage.textContent =
                "%" + Math.round(paidPercent) + " ödendi";


            remainingPercentage.textContent =
                "%" + Math.round(Math.max(0, remainingPercent)) + " kaldı";


            if (currentPayment > remainingAmount) {

                paymentAmount.style.borderColor =
                    "var(--color-danger)";

                submitPayment.disabled = true;

            }
            else {

                paymentAmount.style.borderColor =
                    "";

                submitPayment.disabled =
                    currentPayment <= 0;

            }

        }


        /* =====================================================
           PAYMENT INPUT
        ====================================================== */

        paymentAmount.addEventListener(
            "input",
            updatePaymentSummary
        );


        /* =====================================================
           NOTE COUNTER
        ====================================================== */

        paymentNote.addEventListener(
            "input",
            function () {

                noteCounter.textContent =
                    paymentNote.value.length;

            }
        );


        /* =====================================================
           FORM SUBMIT
        ====================================================== */

        paymentForm.addEventListener(
            "submit",
            function (event) {

                const amount =
                    parseFloat(paymentAmount.value) || 0;

                if (amount <= 0) {

                    event.preventDefault();

                    alert("Lütfen geçerli bir ödeme tutarı giriniz.");

                    return;
                }

                if (amount > remainingAmount) {

                    event.preventDefault();

                    alert(
                        "Ödeme tutarı kalan borçtan fazla olamaz."
                    );

                    return;
                }
            }
        );

        /* =====================================================
           INITIAL STATE
        ====================================================== */

        submitPayment.disabled = true;

        updatePaymentSummary();

    });

</script>
