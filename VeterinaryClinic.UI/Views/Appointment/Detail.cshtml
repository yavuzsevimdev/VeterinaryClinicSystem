@if (User.IsInRole("Manager"))
{
    @model AppointmentDto

    var owner = (UserDto)ViewBag.Owner;
    var animal = (AnimalDto)ViewBag.Animal;
    var statusText = Model.Status switch
    {
        "Scheduled" => "Planlandı",
        "Completed" => "Tamamlandı",
        "Cancelled" => "İptal Edildi",
        _ => Model.Status
    };

    var statusClass = Model.Status switch
    {
        "Scheduled" => "badge-ui--info",
        "Completed" => "badge-ui--success",
        "Cancelled" => "badge-ui--danger",
        _ => "badge-ui--neutral"
    };

    var statusIcon = Model.Status switch
    {
        "Scheduled" => "fa-calendar-check",
        "Completed" => "fa-circle-check",
        "Cancelled" => "fa-calendar-xmark",
        _ => "fa-calendar"
    };

    <div class="manager-appointment-detail-page">

        <!-- =========================================================
         PAGE HEADER
         ========================================================= -->

        <div class="manager-appointment-detail-header">

            <div class="manager-appointment-detail-header-left">

                <div class="manager-appointment-detail-icon">
                    <i class="fa-solid fa-calendar-check"></i>
                </div>

                <div>
                    <div class="manager-appointment-detail-breadcrumb">
                        <a href="/Appointment/Index">
                            Randevular
                        </a>

                        <i class="fa-solid fa-chevron-right"></i>

                        <span>Randevu Detayı</span>
                    </div>

                    <h1>
                        Randevu Detayı
                    </h1>

                    <p>
                        Randevu bilgilerini ve hasta detaylarını görüntüleyin.
                    </p>
                </div>

            </div>

            <div class="manager-appointment-detail-header-actions">

                <a href="/Appointment/Index"
                   class="btn-ui btn-ui--outline">

                    <i class="fa-solid fa-arrow-left"></i>

                    Randevulara Dön

                </a>

            </div>

        </div>


        <!-- =========================================================
         APPOINTMENT HERO
         ========================================================= -->
        @await Component.InvokeAsync("_ManagerAppointmentHeroComponentPartial", new { appointment = Model })


        <!-- =========================================================
         MAIN CONTENT
         ========================================================= -->

        <div class="manager-appointment-detail-grid">


            <!-- =====================================================
             LEFT COLUMN
             ===================================================== -->

            <div class="manager-appointment-detail-main">


                <!-- =================================================
                 ANIMAL INFORMATION
                 ================================================= -->
                @await Component.InvokeAsync("_ManagerAppointmentAnimalInfosComponentPartial", new { appointment = Model })


                <!-- =================================================
                 OWNER INFORMATION
                 ================================================= -->
                @await Component.InvokeAsync("_ManagerAppointmentOwnerInfosComponentPartial", new { appointment = Model })

                <!-- =================================================
                 NOTES
                 ================================================= -->

                <section class="card-ui manager-appointment-detail-card">

                    <div class="section-header">

                        <div class="section-header-text">

                            <div class="section-header-title-row">

                                <div class="card-icon-tile is-accent">
                                    <i class="fa-solid fa-note-sticky"></i>
                                </div>

                                <div>
                                    <h2 class="text-card-title">
                                        Randevu Notu
                                    </h2>

                                    <p class="section-header-desc">
                                        Randevu sırasında dikkate alınması gereken notlar
                                    </p>
                                </div>

                            </div>

                        </div>

                    </div>


                    @if (!string.IsNullOrWhiteSpace(Model.Notes))
                    {
                        <div class="manager-appointment-detail-notes">
                            <i class="fa-solid fa-quote-left"></i>

                            <p>
                                @Model.Notes
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class="manager-appointment-detail-empty">

                            <div class="manager-appointment-detail-empty-icon">
                                <i class="fa-regular fa-note-sticky"></i>
                            </div>

                            <div>
                                <strong>
                                    Not bulunmuyor
                                </strong>

                                <span>
                                    Bu randevu için henüz bir not eklenmemiş.
                                </span>
                            </div>

                        </div>
                    }

                </section>


                <!-- =================================================
                 TREATMENTS
                 ================================================= -->
                @await Component.InvokeAsync("_ManagerAppointmentTreatmentsInfosComponentPartial", new { appointment = Model })

            </div>


            <!-- =====================================================
             RIGHT COLUMN
             ===================================================== -->

            <aside class="manager-appointment-detail-sidebar">


                <!-- =================================================
                 APPOINTMENT SUMMARY
                 ================================================= -->

                <section class="card-ui manager-appointment-detail-card">

                    <div class="manager-appointment-detail-sidebar-title">

                        <div class="card-icon-tile is-primary">
                            <i class="fa-solid fa-calendar-days"></i>
                        </div>

                        <div>
                            <h2 class="text-card-title">
                                Randevu Bilgileri
                            </h2>

                            <p class="section-header-desc">
                                Randevu özeti
                            </p>
                        </div>

                    </div>


                    <div class="manager-appointment-detail-summary">

                        <div class="manager-appointment-detail-summary-item">

                            <span>
                                <i class="fa-solid fa-stethoscope"></i>
                                Randevu Türü
                            </span>

                            <strong>
                                @Model.AppointmentType
                            </strong>

                        </div>


                        <div class="manager-appointment-detail-summary-item">

                            <span>
                                <i class="fa-regular fa-calendar"></i>
                                Tarih
                            </span>

                            <strong>
                                @Model.Date.ToString("dd MMMM yyyy")
                            </strong>

                        </div>


                        <div class="manager-appointment-detail-summary-item">

                            <span>
                                <i class="fa-regular fa-clock"></i>
                                Saat
                            </span>

                            <strong>
                                @Model.Time.ToString(@"hh\:mm")
                            </strong>

                        </div>


                        <div class="manager-appointment-detail-summary-item">

                            <span>
                                <i class="fa-solid fa-circle-info"></i>
                                Durum
                            </span>

                            <span class="badge-ui @statusClass">

                                <i class="fa-solid @statusIcon"></i>

                                @statusText

                            </span>

                        </div>

                    </div>

                </section>


                <!-- =================================================
                 PAYMENT
                 ================================================= -->
                @await Component.InvokeAsync("_ManagerAppointmentPaymentSummaryComponentPartial", new { appointment = Model })

                


                <!-- =================================================
                 QUICK INFORMATION
                 ================================================= -->
                @await Component.InvokeAsync("_ManagerAppointmentQuickInfosComponentPartial", new { appointment = Model })


            </aside>

        </div>


        <!-- =========================================================
         BOTTOM ACTIONS
         ========================================================= -->

        <div class="manager-appointment-detail-actions">

            <div class="manager-appointment-detail-actions-left">

                <a href="/Appointment/Index"
                   class="btn-ui btn-ui--outline">

                    <i class="fa-solid fa-arrow-left"></i>

                    Randevulara Dön

                </a>

            </div>


            <div class="manager-appointment-detail-actions-right">

                <a href="/Appointment/Pdf/@Model.Id"
                   class="btn-ui btn-ui--outline">

                    <i class="fa-solid fa-file-pdf"></i>

                    PDF İndir

                </a>


                <button type="button"
                        class="btn-ui btn-ui--outline"
                        onclick="window.print()">

                    <i class="fa-solid fa-print"></i>

                    Yazdır

                </button>


                <a href="/Appointment/Update/@Model.Id"
                   class="btn-ui btn-ui--primary">

                    <i class="fa-solid fa-pen"></i>

                    Güncelle

                </a>


                @if (Model.Status == "Scheduled")
                {
                    <a href="/Appointment/Cancel/@Model.Id"
                            class="btn btn-ui btn-ui--danger"
                            id="cancelAppointmentBtn">

                        <i class="fa-solid fa-calendar-xmark"></i>

                        Randevuyu İptal Et

                    </a>
                }

            </div>

        </div>

    </div>


    <style>

        /* ============================================================
               MANAGER APPOINTMENT DETAIL
               Scoped to prevent Global UI conflicts
               ============================================================ */

        .manager-appointment-detail-page {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }


        /* ============================================================
               HEADER
               ============================================================ */

        .manager-appointment-detail-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1.5rem;
        }

        .manager-appointment-detail-header-left {
            display: flex;
            align-items: center;
            gap: 1rem;
            min-width: 0;
        }

        .manager-appointment-detail-icon {
            width: 52px;
            height: 52px;
            flex: 0 0 52px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: var(--radius-lg);
            background-color: var(--color-primary-light);
            color: var(--color-primary);
            font-size: 1.35rem;
        }

        .manager-appointment-detail-breadcrumb {
            display: flex;
            align-items: center;
            gap: 7px;
            margin-bottom: 4px;
            font-size: 0.78rem;
        }

            .manager-appointment-detail-breadcrumb a {
                color: var(--color-primary);
                font-weight: 600;
                text-decoration: none;
            }

            .manager-appointment-detail-breadcrumb i {
                color: var(--color-muted-light);
                font-size: 0.65rem;
            }

            .manager-appointment-detail-breadcrumb span {
                color: var(--color-muted);
            }

        .manager-appointment-detail-header h1 {
            margin: 0;
            font-size: 1.85rem;
            font-weight: 700;
            color: var(--color-text);
            letter-spacing: -0.02em;
        }

        .manager-appointment-detail-header p {
            margin: 5px 0 0;
            color: var(--color-muted);
            font-size: 0.88rem;
        }


        /* ============================================================
               HERO
               ============================================================ */

        .manager-appointment-detail-hero {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 2rem;
            padding: 1.75rem;
            background: linear-gradient( 135deg, var(--color-surface) 0%, #f7f5fd 100% );
        }

        .manager-appointment-detail-hero-left {
            display: flex;
            align-items: center;
            gap: 1.25rem;
            min-width: 0;
        }

        .manager-appointment-detail-animal-avatar {
            width: 96px;
            height: 96px;
            flex: 0 0 96px;
            border-radius: 24px;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: var(--color-secondary-light);
            color: #3f7d64;
            font-size: 2rem;
        }

            .manager-appointment-detail-animal-avatar img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .manager-appointment-detail-hero-info {
            min-width: 0;
        }

        .manager-appointment-detail-hero-title-row {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            flex-wrap: wrap;
        }

            .manager-appointment-detail-hero-title-row h2 {
                margin: 0;
                font-size: 1.45rem;
                font-weight: 700;
                color: var(--color-text);
            }

        .manager-appointment-detail-animal-meta {
            display: flex;
            align-items: center;
            gap: 7px;
            margin: 5px 0 1rem;
            color: var(--color-muted);
            font-size: 0.85rem;
        }

        .manager-appointment-detail-hero-date {
            display: flex;
            align-items: center;
            gap: 1.5rem;
            flex-wrap: wrap;
        }

        .manager-appointment-detail-mini-info {
            display: flex;
            align-items: center;
            gap: 0.6rem;
        }

            .manager-appointment-detail-mini-info > i {
                color: var(--color-primary);
                font-size: 1rem;
            }

            .manager-appointment-detail-mini-info div {
                display: flex;
                flex-direction: column;
                gap: 1px;
            }

            .manager-appointment-detail-mini-info span {
                color: var(--color-muted);
                font-size: 0.7rem;
                font-weight: 500;
            }

            .manager-appointment-detail-mini-info strong {
                color: var(--color-text);
                font-size: 0.82rem;
                font-weight: 600;
            }

        .manager-appointment-detail-hero-right {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 4px;
            min-width: 120px;
        }

        .manager-appointment-detail-reference {
            color: var(--color-muted);
            font-size: 0.7rem;
        }

        .manager-appointment-detail-hero-right > strong {
            color: var(--color-primary);
            font-size: 1.25rem;
        }

        .manager-appointment-detail-type {
            color: var(--color-text);
            font-size: 0.78rem;
            font-weight: 600;
        }


        /* ============================================================
               MAIN GRID
               ============================================================ */

        .manager-appointment-detail-grid {
            display: grid;
            grid-template-columns: minmax(0, 2fr) minmax(300px, 1fr);
            gap: 1.5rem;
            align-items: start;
        }

        .manager-appointment-detail-main,
        .manager-appointment-detail-sidebar {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
            min-width: 0;
        }

        .manager-appointment-detail-sidebar {
            position: sticky;
            top: calc(var(--topbar-height) + 1.5rem);
        }


        /* ============================================================
               CARDS
               ============================================================ */

        .manager-appointment-detail-card {
            padding: 1.5rem;
        }

            .manager-appointment-detail-card .section-header {
                margin-bottom: 1.25rem;
            }

            .manager-appointment-detail-card .section-header-title-row {
                display: flex;
                align-items: center;
                gap: 0.75rem;
            }


        /* ============================================================
               ANIMAL INFO
               ============================================================ */

        .manager-appointment-detail-animal-info {
            display: flex;
            align-items: center;
            gap: 1.25rem;
        }

        .manager-appointment-detail-animal-photo {
            width: 104px;
            height: 104px;
            flex: 0 0 104px;
            border-radius: 18px;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: var(--color-secondary-light);
            color: #3f7d64;
            font-size: 2rem;
        }

            .manager-appointment-detail-animal-photo img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .manager-appointment-detail-animal-details {
            flex: 1;
            min-width: 0;
        }

        .manager-appointment-detail-name-row {
            display: flex;
            align-items: center;
            gap: 0.65rem;
            margin-bottom: 1rem;
        }

            .manager-appointment-detail-name-row h3 {
                margin: 0;
                font-size: 1.15rem;
                font-weight: 700;
                color: var(--color-text);
            }

        .manager-appointment-detail-info-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 0.75rem;
        }

        .manager-appointment-detail-info-item {
            display: flex;
            flex-direction: column;
            gap: 5px;
            padding: 0.75rem;
            background-color: var(--color-surface-alt);
            border-radius: var(--radius-md);
        }

            .manager-appointment-detail-info-item span {
                display: flex;
                align-items: center;
                gap: 5px;
                color: var(--color-muted);
                font-size: 0.7rem;
                font-weight: 500;
            }

                .manager-appointment-detail-info-item span i {
                    color: var(--color-primary);
                }

            .manager-appointment-detail-info-item strong {
                color: var(--color-text);
                font-size: 0.82rem;
                font-weight: 600;
            }


        /* ============================================================
               OWNER
               ============================================================ */

        .manager-appointment-detail-owner {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 0.25rem;
        }

        .manager-appointment-detail-owner-avatar {
            width: 54px;
            height: 54px;
            flex: 0 0 54px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background-color: var(--color-primary-light);
            color: var(--color-primary);
            font-size: 1.15rem;
        }

        .manager-appointment-detail-owner-info {
            min-width: 0;
        }

            .manager-appointment-detail-owner-info > strong {
                display: block;
                margin-bottom: 5px;
                color: var(--color-text);
                font-size: 0.95rem;
            }

            .manager-appointment-detail-owner-info > div {
                display: flex;
                align-items: center;
                gap: 1rem;
                flex-wrap: wrap;
            }

            .manager-appointment-detail-owner-info span {
                display: inline-flex;
                align-items: center;
                gap: 5px;
                color: var(--color-muted);
                font-size: 0.78rem;
            }

                .manager-appointment-detail-owner-info span i {
                    color: var(--color-primary);
                }


        /* ============================================================
               NOTES
               ============================================================ */

        .manager-appointment-detail-notes {
            display: flex;
            gap: 0.8rem;
            padding: 1rem 1.1rem;
            border-radius: var(--radius-md);
            background-color: var(--color-primary-light);
            color: var(--color-text);
        }

            .manager-appointment-detail-notes > i {
                color: var(--color-primary);
                font-size: 1rem;
                padding-top: 2px;
            }

            .manager-appointment-detail-notes p {
                margin: 0;
                line-height: 1.7;
                font-size: 0.84rem;
            }


        /* ============================================================
               SIDEBAR
               ============================================================ */

        .manager-appointment-detail-sidebar-title {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin-bottom: 1.25rem;
        }

            .manager-appointment-detail-sidebar-title .section-header-desc {
                margin-top: 3px;
            }


        /* ============================================================
               SUMMARY
               ============================================================ */

        .manager-appointment-detail-summary {
            display: flex;
            flex-direction: column;
            gap: 0;
        }

        .manager-appointment-detail-summary-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            padding: 0.85rem 0;
            border-bottom: 1px solid var(--color-border);
        }

            .manager-appointment-detail-summary-item:first-child {
                padding-top: 0;
            }

            .manager-appointment-detail-summary-item:last-child {
                padding-bottom: 0;
                border-bottom: none;
            }

            .manager-appointment-detail-summary-item > span:first-child {
                display: flex;
                align-items: center;
                gap: 7px;
                color: var(--color-muted);
                font-size: 0.78rem;
            }

                .manager-appointment-detail-summary-item > span:first-child i {
                    color: var(--color-primary);
                    width: 15px;
                    text-align: center;
                }

            .manager-appointment-detail-summary-item > strong {
                color: var(--color-text);
                font-size: 0.8rem;
                font-weight: 600;
                text-align: right;
            }


        /* ============================================================
               PAYMENT
               ============================================================ */

        .manager-appointment-detail-payment {
            display: flex;
            flex-direction: column;
            gap: 0;
        }

        .manager-appointment-detail-payment-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.65rem 0;
        }

            .manager-appointment-detail-payment-row span {
                color: var(--color-muted);
                font-size: 0.78rem;
            }

            .manager-appointment-detail-payment-row strong {
                color: var(--color-text);
                font-size: 0.85rem;
                font-weight: 600;
            }

                .manager-appointment-detail-payment-row strong.is-success {
                    color: var(--color-success);
                }

        .manager-appointment-detail-payment-divider {
            height: 1px;
            background-color: var(--color-border);
            margin: 0.35rem 0;
        }

        .manager-appointment-detail-payment-row.is-total {
            padding-top: 0.9rem;
        }

            .manager-appointment-detail-payment-row.is-total strong {
                color: var(--color-primary);
                font-size: 1rem;
            }


        /* ============================================================
               QUICK INFO
               ============================================================ */

        .manager-appointment-detail-quick-info {
            display: flex;
            flex-direction: column;
        }

            .manager-appointment-detail-quick-info > div {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 1rem;
                padding: 0.75rem 0;
                border-bottom: 1px solid var(--color-border);
            }

                .manager-appointment-detail-quick-info > div:first-child {
                    padding-top: 0;
                }

                .manager-appointment-detail-quick-info > div:last-child {
                    padding-bottom: 0;
                    border-bottom: none;
                }

            .manager-appointment-detail-quick-info span {
                color: var(--color-muted);
                font-size: 0.78rem;
            }

            .manager-appointment-detail-quick-info strong {
                color: var(--color-text);
                font-size: 0.8rem;
                font-weight: 600;
            }


        /* ============================================================
               EMPTY STATE
               ============================================================ */

        .manager-appointment-detail-empty {
            display: flex;
            align-items: center;
            gap: 0.85rem;
            padding: 1rem;
            border: 1px dashed var(--color-border-strong);
            border-radius: var(--radius-md);
            background-color: var(--color-surface-alt);
        }

        .manager-appointment-detail-empty-icon {
            width: 40px;
            height: 40px;
            flex: 0 0 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: var(--radius-md);
            background-color: var(--color-primary-light);
            color: var(--color-primary);
        }

        .manager-appointment-detail-empty > div:last-child {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .manager-appointment-detail-empty strong {
            color: var(--color-text);
            font-size: 0.82rem;
        }

        .manager-appointment-detail-empty span {
            color: var(--color-muted);
            font-size: 0.74rem;
            line-height: 1.5;
        }


        /* ============================================================
               BOTTOM ACTIONS
               ============================================================ */

        .manager-appointment-detail-actions {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            padding: 1rem 0 0.25rem;
            border-top: 1px solid var(--color-border);
        }

        .manager-appointment-detail-actions-left,
        .manager-appointment-detail-actions-right {
            display: flex;
            align-items: center;
            gap: 0.65rem;
            flex-wrap: wrap;
        }


        /* ============================================================
               RESPONSIVE
               ============================================================ */

        @@media (max-width: 1100px) {

            .manager-appointment-detail-grid {
                grid-template-columns: 1fr;
            }

            .manager-appointment-detail-sidebar {
                position: static;
            }

            .manager-appointment-detail-info-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }


        @@media (max-width: 767.98px) {

            .manager-appointment-detail-header {
                align-items: flex-start;
                flex-direction: column;
            }

            .manager-appointment-detail-header-actions {
                width: 100%;
            }

                .manager-appointment-detail-header-actions .btn-ui {
                    width: 100%;
                }

            .manager-appointment-detail-hero {
                align-items: flex-start;
                flex-direction: column;
            }

            .manager-appointment-detail-hero-left {
                align-items: flex-start;
            }

            .manager-appointment-detail-hero-right {
                align-items: flex-start;
                padding-left: calc(96px + 1.25rem);
            }

            .manager-appointment-detail-animal-info {
                align-items: flex-start;
                flex-direction: column;
            }

            .manager-appointment-detail-info-grid {
                grid-template-columns: 1fr 1fr;
                width: 100%;
            }

            .manager-appointment-detail-actions {
                align-items: stretch;
                flex-direction: column;
            }

            .manager-appointment-detail-actions-left,
