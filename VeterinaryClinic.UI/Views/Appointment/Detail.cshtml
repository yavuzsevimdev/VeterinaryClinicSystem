<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Randevu Detayı — VetCare</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

    <style>

            :root {
                --color-primary: #6C63A8;
                --color-primary-dark: #554C91;
                --color-primary-light: #EDEBF7;
                --color-secondary: #8FC9B5;
                --color-secondary-light: #E7F4EF;
                --color-accent: #F3B7A5;
                --color-accent-light: #FDEEE9;
                --color-background: #F8F7FC;
                --color-surface: #FFFFFF;
                --color-surface-alt: #FBFAFD;
                --color-border: #E7E4F2;
                --color-border-strong: #D8D3EC;
                --color-text: #303044;
                --color-muted: #7B7B90;
                --color-muted-light: #A6A4B8;
                --color-success: #71B58A;
                --color-success-light: #E7F5EC;
                --color-warning: #E8B86A;
                --color-warning-light: #FBF0DE;
                --color-danger: #DF7C89;
                --color-danger-light: #FBE9EB;
                --color-info: #7FAFD0;
                --color-info-light: #E9F2F8;
                --gradient-primary: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
                --font-family-base: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
                --radius-sm: 8px;
                --radius-md: 12px;
                --radius-lg: 16px;
                --radius-pill: 999px;
                --shadow-xs: 0 1px 2px rgba(48, 48, 68, 0.05);
                --shadow-sm: 0 2px 8px rgba(48, 48, 68, 0.06);
                --shadow-md: 0 8px 24px rgba(48, 48, 68, 0.08);
                --shadow-primary-glow: 0 8px 20px rgba(108, 99, 168, 0.28);
                --transition-fast: 150ms ease;
                --transition-base: 220ms cubic-bezier(0.4, 0, 0.2, 1);
                --transition-slow: 360ms cubic-bezier(0.4, 0, 0.2, 1);
            }

            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                font-family: var(--font-family-base);
                background-color: var(--color-background);
                color: var(--color-text);
                font-size: 0.9375rem;
                line-height: 1.55;
                -webkit-font-smoothing: antialiased;
            }

            img, svg {
                display: block;
                max-width: 100%;
            }

            button {
                font: inherit;
                color: inherit;
                background: none;
                border: none;
                padding: 0;
                cursor: pointer;
            }

            a {
                text-decoration: none;
                color: inherit;
            }

            ul {
                margin: 0;
                padding: 0;
                list-style: none;
            }

            h1, h2, h3 {
                margin: 0;
                font-weight: 600;
                line-height: 1.25;
            }

            p {
                margin: 0;
            }

            :focus-visible {
                outline: 2px solid var(--color-primary);
                outline-offset: 2px;
                border-radius: var(--radius-sm);
            }

            .text-section-title {
                font-size: 1.1rem;
                font-weight: 600;
            }

            .text-card-title {
                font-size: 1.05rem;
                font-weight: 600;
            }

            .text-small {
                font-size: 0.8125rem;
            }

            .text-muted {
                color: var(--color-muted) !important;
            }

            .app-content {
                max-width: 1320px;
                margin: 0 auto;
                padding: 2rem 2.5rem 4rem;
            }

            .app-content-inner {
                display: flex;
                flex-direction: column;
                gap: 1.5rem;
            }

            /* ---- Reused global components ---- */

            .breadcrumb-ui {
                display: flex;
                align-items: center;
                flex-wrap: wrap;
                gap: 6px;
                font-size: 0.8125rem;
            }

            .breadcrumb-ui-item {
                color: var(--color-muted);
                font-weight: 500;
            }

                .breadcrumb-ui-item a:hover {
                    color: var(--color-primary-dark);
                }

                .breadcrumb-ui-item.is-current {
                    color: var(--color-text);
                    font-weight: 600;
                }

            .breadcrumb-ui-sep {
                color: var(--color-muted-light);
                font-size: 0.7rem;
            }

            .card-ui {
                background-color: var(--color-surface);
                border: 1px solid var(--color-border);
                border-radius: var(--radius-lg);
                padding: 1.5rem;
                box-shadow: var(--shadow-xs);
            }

            .btn-ui {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 0.5rem;
                border-radius: var(--radius-md);
                font-weight: 600;
                font-size: 0.85rem;
                line-height: 1;
                white-space: nowrap;
                border: 1px solid transparent;
                padding: 0.65rem 1.1rem;
                transition: background-color var(--transition-fast), border-color var(--transition-fast), color var(--transition-fast), transform var(--transition-fast);
            }

                .btn-ui:active {
                    transform: scale(0.98);
                }

            .btn-ui--sm {
                padding: 0.45rem 0.85rem;
                font-size: 0.78rem;
                border-radius: var(--radius-sm);
            }

            .btn-ui--primary {
                background: var(--gradient-primary);
                color: #fff;
                box-shadow: var(--shadow-primary-glow);
            }

                .btn-ui--primary:hover {
                    filter: brightness(1.06);
                }

            .btn-ui--ghost {
                background-color: var(--color-surface);
                border: 1px solid var(--color-border-strong);
                color: var(--color-text);
            }

                .btn-ui--ghost:hover {
                    border-color: var(--color-primary);
                    color: var(--color-primary-dark);
                    background-color: var(--color-primary-light);
                }

            .badge-ui {
                display: inline-flex;
                align-items: center;
                gap: 5px;
                padding: 0.3rem 0.65rem;
                border-radius: var(--radius-pill);
                font-size: 0.7rem;
                font-weight: 600;
                line-height: 1;
                white-space: nowrap;
            }

            .badge-ui--success {
                background-color: var(--color-success-light);
                color: #3f7d5c;
            }

            .badge-ui--primary {
                background-color: var(--color-primary-light);
                color: var(--color-primary-dark);
            }

            .card-icon-tile {
                flex: 0 0 auto;
                width: 40px;
                height: 40px;
                border-radius: var(--radius-md);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.05rem;
            }

                .card-icon-tile.is-primary {
                    background-color: var(--color-primary-light);
                    color: var(--color-primary);
                }

                .card-icon-tile.is-secondary {
                    background-color: var(--color-secondary-light);
                    color: #3f7d64;
                }

                .card-icon-tile.is-info {
                    background-color: var(--color-info-light);
                    color: var(--color-info);
                }

                .card-icon-tile.is-success {
                    background-color: var(--color-success-light);
                    color: var(--color-success);
                }

                .card-icon-tile.is-accent {
                    background-color: var(--color-accent-light);
                    color: #c96b4f;
                }

            .card-header-row {
                display: flex;
                align-items: flex-start;
                justify-content: space-between;
                gap: 0.75rem;
                margin-bottom: 1.1rem;
            }

            .card-header-title {
                display: flex;
                align-items: center;
                gap: 0.75rem;
                min-width: 0;
            }

                .card-header-title .card-icon-tile {
                    width: 36px;
                    height: 36px;
                    font-size: 0.95rem;
                }

            /* ==========================================================================
                           NAV ROW (Randevulara Dön / Yazdır)
                           ========================================================================== */

            .appointment-detail-navrow {
                display: flex;
                align-items: center;
                justify-content: space-between;
            }

            .appointment-detail-right-actions {
                display: flex;
                flex-direction: row;
                align-items: center;
                gap: 10px;
            }

            /* ==========================================================================
                           HEADER CARD
                           ========================================================================== */

            .appointment-detail-header {
                display: grid;
                grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr) minmax(0, 0.95fr);
                gap: 1.5rem;
                align-items: center;
                padding: 1.5rem;
            }

            .appointment-detail-identity {
                display: flex;
                align-items: center;
                gap: 1.4rem;
                min-width: 0;
            }

            .appointment-detail-photo {
                flex: 0 0 auto;
                width: 132px;
                height: 132px;
                border-radius: 50%;
                padding: 4px;
                background: linear-gradient(135deg, var(--color-secondary) 0%, var(--color-primary-light) 100%);
                box-shadow: var(--shadow-sm);
            }

            .appointment-detail-photo-inner {
                width: 100%;
                height: 100%;
                border-radius: 50%;
                overflow: hidden;
                background: linear-gradient(135deg, var(--color-secondary-light) 0%, var(--color-primary-light) 100%);
                display: flex;
                align-items: center;
                justify-content: center;
                border: 3px solid var(--color-surface);
            }

                .appointment-detail-photo-inner img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                }

            .appointment-detail-photo-fallback {
                font-size: 2.4rem;
                color: var(--color-primary);
                opacity: 0.6;
            }

            .appointment-detail-identity-body {
                min-width: 0;
            }

            .appointment-detail-name-row {
                display: flex;
                align-items: center;
                gap: 0.6rem;
                flex-wrap: wrap;
            }

            .appointment-detail-name {
                font-size: 1.6rem;
                font-weight: 700;
                letter-spacing: -0.01em;
            }

            .appointment-detail-species-pill {
                display: inline-flex;
                align-items: center;
                gap: 5px;
                background-color: var(--color-primary-light);
                color: var(--color-primary-dark);
                font-size: 0.75rem;
                font-weight: 600;
                padding: 4px 11px;
                border-radius: var(--radius-pill);
            }

            .appointment-detail-meta {
                margin-top: 4px;
                color: var(--color-muted);
                font-size: 0.875rem;
            }

            .appointment-detail-chip {
                margin-top: 0.75rem;
                display: inline-flex;
                align-items: center;
                gap: 8px;
                max-width: 100%;
                background-color: var(--color-surface-alt);
                border: 1px solid var(--color-border);
                border-radius: var(--radius-md);
                padding: 6px 10px;
                font-size: 0.75rem;
                color: var(--color-muted);
            }

                .appointment-detail-chip strong {
                    color: var(--color-text);
                    font-weight: 600;
                    overflow: hidden;
                    text-overflow: ellipsis;
                }

            .appointment-detail-chip-copy {
                color: var(--color-muted-light);
                font-size: 0.85rem;
                transition: color var(--transition-fast);
            }

                .appointment-detail-chip-copy:hover {
                    color: var(--color-primary);
                }

            .appointment-detail-datetime {
                display: flex;
                flex-direction: column;
                gap: 0.75rem;
                padding: 0 1.5rem;
                border-left: 1px solid var(--color-border);
                border-right: 1px solid var(--color-border);
            }

            .appointment-detail-datetime-card {
                display: flex;
                align-items: center;
                gap: 0.85rem;
                padding: 0.8rem 1rem;
                border-radius: var(--radius-md);
                background-color: var(--color-info-light);
            }

                .appointment-detail-datetime-card .card-icon-tile {
                    background-color: rgba(255, 255, 255, 0.75);
                }

            .appointment-detail-datetime-value {
                font-size: 1.05rem;
                font-weight: 700;
                line-height: 1.2;
            }

            .appointment-detail-datetime-sub {
                font-size: 0.8125rem;
                color: var(--color-muted);
            }

            .appointment-detail-status {
                display: flex;
                flex-direction: column;
                gap: 0.75rem;
                text-align: center;
            }

            .appointment-detail-status-card {
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 0.6rem;
                padding: 1rem;
                border-radius: var(--radius-md);
                background-color: var(--color-success-light);
                color: #3f7d5c;
                font-weight: 700;
                font-size: 1.05rem;
            }

            .appointment-detail-status-id {
                font-size: 0.8125rem;
                color: var(--color-muted);
            }

            .appointment-detail-status-created {
                font-size: 0.75rem;
                color: var(--color-muted-light);
            }

            /* ==========================================================================
                           TABS
                           ========================================================================== */

            .appointment-detail-tabs {
                display: flex;
                gap: 0.25rem;
                border-bottom: 1px solid var(--color-border);
                overflow-x: auto;
                scrollbar-width: none;
            }

                .appointment-detail-tabs::-webkit-scrollbar {
                    display: none;
                }

            .appointment-detail-tab {
                flex: 0 0 auto;
                display: inline-flex;
                align-items: center;
                gap: 0.5rem;
                padding: 0.85rem 1.1rem;
                font-size: 0.875rem;
                font-weight: 500;
                color: var(--color-muted);
                border-bottom: 2px solid transparent;
                margin-bottom: -1px;
                transition: color var(--transition-fast), border-color var(--transition-fast);
            }

                .appointment-detail-tab:hover {
                    color: var(--color-primary-dark);
                }

                .appointment-detail-tab.is-active {
                    color: var(--color-primary);
                    border-bottom-color: var(--color-primary);
                    font-weight: 600;
                }

            /* ==========================================================================
                           MAIN GRID — 70 / 30
                           ========================================================================== */

            .appointment-detail-grid {
                display: grid;
                grid-template-columns: minmax(0, 7fr) minmax(0, 3fr);
                gap: 1.5rem;
                align-items: start;
            }

            .appointment-detail-col {
                display: flex;
                flex-direction: column;
                gap: 1.5rem;
                min-width: 0;
            }

            .appointment-detail-subgrid {
                display: grid;
                grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
                gap: 1.5rem;
                align-items: start;
            }

            .appointment-detail-card-desc {
                color: var(--color-muted);
                font-size: 0.8125rem;
                margin: -0.6rem 0 1.25rem 3rem;
            }

            .appointment-detail-count {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                min-width: 22px;
                height: 22px;
                padding: 0 6px;
                border-radius: var(--radius-pill);
                background-color: var(--color-surface-alt);
                border: 1px solid var(--color-border);
                font-size: 0.7rem;
                font-weight: 600;
                color: var(--color-muted);
            }

            /* ==========================================================================
                           TIMELINE
                           ========================================================================== */

            .appointment-timeline {
                display: flex;
                flex-direction: column;
            }

            .appointment-timeline-item {
                display: grid;
                grid-template-columns: 58px 46px minmax(0, 1fr) auto;
                column-gap: 1rem;
                align-items: stretch;
            }

            .appointment-timeline-time {
                padding-top: 0.8rem;
                font-size: 0.85rem;
                font-weight: 600;
                color: var(--color-text);
                text-align: right;
            }

            .appointment-timeline-marker {
                display: flex;
                flex-direction: column;
                align-items: center;
            }

            .appointment-timeline-dot {
                flex: 0 0 auto;
                width: 46px;
                height: 46px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.15rem;
                box-shadow: 0 0 0 4px var(--color-surface);
            }

                .appointment-timeline-dot.is-success {
                    background-color: var(--color-success-light);
                    color: var(--color-success);
                }

                .appointment-timeline-dot.is-info {
                    background-color: var(--color-info-light);
                    color: var(--color-info);
                }

                .appointment-timeline-dot.is-primary {
                    background-color: var(--color-primary-light);
                    color: var(--color-primary);
                }

                .appointment-timeline-dot.is-accent {
                    background-color: var(--color-accent-light);
                    color: #c96b4f;
                }

            .appointment-timeline-line {
                flex: 1 1 auto;
                width: 2px;
                min-height: 18px;
                margin: 2px 0;
                background: repeating-linear-gradient(to bottom, var(--color-border-strong) 0 5px, transparent 5px 9px);
            }

            .appointment-timeline-item:last-child .appointment-timeline-line {
                display: none;
            }

            .appointment-timeline-body {
                padding: 0.55rem 0 1.4rem;
                border-bottom: 1px solid var(--color-border);
                min-width: 0;
            }

            .appointment-timeline-item:last-child .appointment-timeline-body {
                border-bottom: none;
                padding-bottom: 0.2rem;
            }

            .appointment-timeline-title {
                font-size: 0.95rem;
                font-weight: 600;
            }

            .appointment-timeline-text {
                font-size: 0.8125rem;
                color: var(--color-muted);
                margin-top: 2px;
            }

            .appointment-timeline-stamp {
                padding-top: 0.65rem;
                font-size: 0.75rem;
                color: var(--color-muted-light);
                text-align: right;
                line-height: 1.5;
                white-space: nowrap;
            }

            .appointment-detail-notice {
                display: flex;
                align-items: center;
                gap: 1rem;
                margin-top: 1.5rem;
                padding: 1rem 1.25rem;
                border-radius: var(--radius-md);
                background: linear-gradient(135deg, var(--color-success-light) 0%, var(--color-info-light) 100%);
                border: 1px solid var(--color-border);
            }

                .appointment-detail-notice .card-icon-tile {
                    background-color: rgba(255, 255, 255, 0.8);
                    color: var(--color-success);
                    width: 46px;
                    height: 46px;
                    border-radius: 50%;
                    font-size: 1.3rem;
                }

            .appointment-detail-notice-title {
                font-weight: 700;
                color: #3f7d5c;
                font-size: 0.95rem;
            }

            .appointment-detail-notice-text {
                font-size: 0.8125rem;
                color: var(--color-muted);
                margin-top: 1px;
            }

            /* ==========================================================================
                           TREATMENTS + MEDICATION
                           ========================================================================== */

            .appointment-detail-rows-head,
            .appointment-detail-row {
                display: grid;
                align-items: center;
                column-gap: 0.75rem;
            }

            .appointment-treatment-cols {
                grid-template-columns: 28px minmax(0, 1.1fr) minmax(0, 1.4fr) auto;
            }

            .appointment-medication-cols {
                grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr) auto;
            }

            .appointment-detail-rows-head {
                padding: 0.6rem 0.75rem;
                margin-bottom: 0.25rem;
                background-color: var(--color-surface-alt);
                border-radius: var(--radius-sm);
                font-size: 0.7rem;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 0.04em;
                color: var(--color-muted);
            }

            .appointment-detail-row {
                padding: 0.85rem 0.75rem;
                border-bottom: 1px solid var(--color-border);
                font-size: 0.8125rem;
            }

                .appointment-detail-row:last-of-type {
                    border-bottom: none;
                }

            .appointment-detail-row-title {
                font-weight: 600;
                color: var(--color-text);
            }

            .appointment-detail-row-sub {
                color: var(--color-muted);
                font-size: 0.75rem;
            }

            .appointment-detail-row-amount {
                font-weight: 600;
                text-align: right;
                white-space: nowrap;
            }

            .appointment-detail-cell-label {
                display: none;
            }

            .appointment-detail-total {
                display: flex;
                align-items: center;
                justify-content: space-between;
                margin-top: 0.5rem;
                padding: 0.9rem 0.75rem 0;
                border-top: 1px solid var(--color-border);
                font-weight: 600;
            }

            .appointment-detail-total-value {
                font-size: 1.15rem;
                font-weight: 700;
                color: var(--color-primary);
            }

            .appointment-detail-reco {
                margin-top: 1.25rem;
                padding: 1rem 1.15rem;
                border-radius: var(--radius-md);
                background-color: var(--color-success-light);
                border: 1px solid rgba(113, 181, 138, 0.25);
            }

            .appointment-detail-reco-title {
                display: flex;
                align-items: center;
                gap: 6px;
                font-size: 0.85rem;
                font-weight: 700;
                color: #3f7d5c;
                margin-bottom: 0.5rem;
            }

            .appointment-detail-reco ul {
                padding-left: 1.1rem;
                list-style: disc;
                font-size: 0.8125rem;
                color: var(--color-text);
            }

            .appointment-detail-reco li {
                margin-bottom: 4px;
            }

                .appointment-detail-reco li:last-child {
                    margin-bottom: 0;
                }

            /* ==========================================================================
                           SIDE CARDS
                           ========================================================================== */

            .appointment-detail-info-list {
                display: flex;
                flex-direction: column;
            }

            .appointment-detail-info-row {
                display: grid;
                grid-template-columns: 22px minmax(0, 1fr) minmax(0, 1.2fr);
                column-gap: 0.75rem;
                align-items: center;
                padding: 0.6rem 0;
                font-size: 0.8125rem;
            }

                .appointment-detail-info-row > i {
                    color: var(--color-primary);
                    font-size: 1rem;
                }

            .appointment-detail-info-label {
                color: var(--color-muted);
            }

            .appointment-detail-info-value {
                font-weight: 500;
                color: var(--color-text);
                overflow-wrap: anywhere;
            }

            .appointment-detail-clinic {
                display: flex;
                gap: 1rem;
                align-items: flex-start;
            }

            .appointment-detail-clinic-media {
                flex: 0 0 auto;
                width: 104px;
                height: 88px;
                border-radius: var(--radius-md);
                background: linear-gradient(135deg, var(--color-info-light) 0%, var(--color-primary-light) 100%);
                display: flex;
                align-items: center;
                justify-content: center;
                color: var(--color-primary);
                font-size: 2rem;
                opacity: 0.85;
            }

            .appointment-detail-clinic-name {
                font-size: 0.9rem;
                font-weight: 700;
            }

            .appointment-detail-clinic-address {
                font-size: 0.8125rem;
                color: var(--color-muted);
                margin-top: 2px;
            }

            .appointment-detail-clinic-phone {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                margin-top: 6px;
                font-size: 0.8125rem;
                font-weight: 500;
                color: var(--color-primary);
            }

            .appointment-detail-actions {
                display: flex;
                flex-direction: column;
                gap: 0.6rem;
            }

                .appointment-detail-actions .btn-ui {
                    width: 100%;
                    justify-content: flex-start;
                    padding: 0.75rem 1rem;
                }

                    .appointment-detail-actions .btn-ui i {
                        color: var(--color-primary);
                        font-size: 1rem;
                    }

            .appointment-detail-owner-row {
                display: flex;
                align-items: center;
                gap: 0.85rem;
                padding: 0.5rem 0;
                font-size: 0.8125rem;
                min-width: 0;
            }

                .appointment-detail-owner-row > i {
                    flex: 0 0 auto;
                    width: 22px;
                    text-align: center;
                    color: var(--color-primary);
                    font-size: 1rem;
                }

                .appointment-detail-owner-row span {
                    overflow-wrap: anywhere;
                }

            .appointment-detail-owner-name {
                font-weight: 600;
                font-size: 0.9rem;
            }

            /* ---- Toast ---- */

            .appointment-toast-stack {
                position: fixed;
                top: 1.5rem;
                right: 1.5rem;
                z-index: 999;
                display: flex;
                flex-direction: column;
                gap: 0.75rem;
                width: min(340px, calc(100vw - 3rem));
            }

            .appointment-toast {
                background-color: var(--color-surface);
                border-radius: var(--radius-md);
                box-shadow: var(--shadow-md);
                border: 1px solid var(--color-border);
                padding: 0.9rem 1rem;
                display: flex;
                align-items: flex-start;
                gap: 0.65rem;
                position: relative;
                overflow: hidden;
                animation: appointment-toast-in var(--transition-slow);
            }

                .appointment-toast.is-leaving {
                    animation: appointment-toast-out var(--transition-base) forwards;
                }

                .appointment-toast::before {
                    content: "";
                    position: absolute;
                    left: 0;
                    top: 0;
                    bottom: 0;
                    width: 4px;
                    background-color: var(--color-primary);
                }

            .appointment-toast-icon {
                color: var(--color-primary);
                font-size: 1.05rem;
            }

            .appointment-toast-message {
                font-size: 0.8125rem;
            }

            @@keyframes appointment-toast-in {
                from {
                    opacity: 0;
                    transform: translateX(20px);
                }

                to {
                    opacity: 1;
                    transform: translateX(0);
                }
            }

            @@keyframes appointment-toast-out {
                from {
                    opacity: 1;
                    transform: translateX(0);
                }

                to {
                    opacity: 0;
                    transform: translateX(20px);
                }
            }

            /* ==========================================================================
                           RESPONSIVE
                           ========================================================================== */

            @@media (max-width: 1199.98px) {
                .app-content {
                    padding: 1.75rem;
                }

                .appointment-detail-header {
                    grid-template-columns: 1fr 1fr;
                }

                .appointment-detail-identity {
                    grid-column: 1 / -1;
                }

                .appointment-detail-datetime {
                    padding: 0 1.5rem 0 0;
                    border-left: none;
                }

                .appointment-detail-subgrid {
                    grid-template-columns: 1fr;
                }
            }

            @@media (max-width: 991.98px) {
                .appointment-detail-grid {
                    grid-template-columns: 1fr;
                }
            }

            @@media (max-width: 767.98px) {
                .app-content {
                    padding: 1.25rem;
                }

                .appointment-detail-header {
                    grid-template-columns: 1fr;
                    gap: 1.25rem;
                    padding: 1.25rem;
                }

                .appointment-detail-identity {
                    flex-direction: column;
                    align-items: flex-start;
                }

                .appointment-detail-datetime {
                    padding: 1.1rem 0 0;
                    border-right: none;
                    border-top: 1px solid var(--color-border);
                }

                .appointment-detail-navrow .btn-ui {
                    flex: 1 1 auto;
                }

                .appointment-detail-card-desc {
                    margin-left: 0;
                }
            }

            @@media (max-width: 575.98px) {
                .appointment-timeline-item {
                    grid-template-columns: 44px 40px minmax(0, 1fr);
                    column-gap: 0.65rem;
                }

                .appointment-timeline-stamp {
                    display: none;
                }

                .appointment-timeline-dot {
                    width: 40px;
                    height: 40px;
                    font-size: 1rem;
                }

                .appointment-timeline-time {
                    font-size: 0.78rem;
                }

                .appointment-detail-rows-head {
                    display: none;
                }

                .appointment-treatment-cols {
                    grid-template-columns: 24px minmax(0, 1fr) auto;
                    grid-template-areas: "num title amount" ". desc desc";
                    row-gap: 2px;
                }

                    .appointment-treatment-cols .c-num {
                        grid-area: num;
                    }

                    .appointment-treatment-cols .c-title {
                        grid-area: title;
                    }

                    .appointment-treatment-cols .c-desc {
                        grid-area: desc;
                    }

                    .appointment-treatment-cols .c-amount {
                        grid-area: amount;
                    }

                .appointment-medication-cols {
                    grid-template-columns: minmax(0, 1fr) auto;
                    grid-template-areas: "name span" "use use";
                    row-gap: 2px;
                }

                    .appointment-medication-cols .c-name {
                        grid-area: name;
                    }

                    .appointment-medication-cols .c-use {
                        grid-area: use;
                    }

                    .appointment-medication-cols .c-span {
                        grid-area: span;
                    }

                .appointment-detail-clinic {
                    flex-direction: column;
                }

                .appointment-detail-clinic-media {
                    width: 100%;
                    height: 110px;
                }

                .appointment-detail-notice {
                    align-items: flex-start;
                }
            }

            @@media print {
                .appointment-detail-navrow, .appointment-detail-tabs, .appointment-detail-actions-card, .appointment-toast-stack {
                    display: none !important;
                }

                body {
                    background: #fff;
                }

                .app-content {
                    padding: 0;
                }

                .card-ui {
                    box-shadow: none;
                }
            }

            appointment-detail-status-card.is-completed {
                background-color: var(--color-success-light);
                color: var(--color-success);
            }

            .appointment-detail-status-card.is-scheduled {
                background-color: var(--color-warning-light);
                color: var(--color-warning);
            }

            .appointment-detail-status-card.is-cancelled {
                background-color: var(--color-danger-light);
                color: var(--color-danger);
            }

    </style>
</head>
<body>

    <main class="app-content">
        <div class="app-content-inner">

            <!-- ==================================================================
           1) BREADCRUMB + ÜST NAVIGATION
           ================================================================== -->
            <nav class="breadcrumb-ui" aria-label="Breadcrumb">
                <span class="breadcrumb-ui-item"><a href="/home/dashboard" aria-label="Ana Sayfa"><i class="bi bi-house-door"></i></a></span>
                <span class="breadcrumb-ui-sep"><i class="bi bi-chevron-right"></i></span>
                <span class="breadcrumb-ui-item"><a href="/appointment/index">Randevular</a></span>
                <span class="breadcrumb-ui-sep"><i class="bi bi-chevron-right"></i></span>
                <span class="breadcrumb-ui-item is-current">Randevu Detayı</span>
            </nav>

            <div class="appointment-detail-navrow">
                <a href="/appointment/index"
                   class="btn-ui btn-ui--ghost btn-ui--sm"
                   id="backBtn">
                    <i class="bi bi-arrow-left"></i> Randevulara Dön
                </a>

                <div class="appointment-detail-right-actions">
                    <a asp-controller="Appointment"
                       asp-action="Pdf"
                       asp-route-id="@ViewBag.AppointmentId"
                       class="btn-ui btn-ui--outline btn-ui--sm">
                        <i class="bi bi-file-earmark-pdf"></i> PDF İndir
                    </a>

                    <button type="button"
                            class="btn-ui btn-ui--outline btn-ui--sm"
                            id="printBtn">
                        <i class="bi bi-printer"></i> Yazdır
                    </button>
                </div>
            </div>

            <!-- ==================================================================
           2) RANDEVU / HAYVAN HEADER CARD
           ================================================================== -->
            @await Component.InvokeAsync("_AppointmentDetailHeaderComponentPartial", new { id = (int)ViewBag.AppointmentId })

            <!-- ==================================================================
           3) SEKME NAVIGATION (yalnızca görsel)
           ================================================================== -->

            <nav class="appointment-detail-tabs" aria-label="Randevu bölümleri" role="tablist">
                <button type="button" class="appointment-detail-tab is-active" role="tab" aria-selected="true"><i class="bi bi-grid-1x2"></i> Genel Bakış</button>
            </nav>

            <!-- ==================================================================
           4) ANA İÇERİK — 70 / 30
           ================================================================== -->
            <div class="appointment-detail-grid">

                <!-- ------------------------ SOL KOLON ------------------------ -->
                <div class="appointment-detail-col">

                    <!-- 5) TEDAVİ SÜRECİ TIMELINE -->
                    @await Component.InvokeAsync("_AppointmentDetailTimelineComponentPartial", new { id = (int)ViewBag.AppointmentId })

                    <!-- 11) UYGULANAN TEDAVİLER + 12) İLAÇ VE ÖNERİLER -->
                    @await Component.InvokeAsync("_AppointmentDetailAppliedTreatmentsComponentPartial", new { id = (int)ViewBag.AppointmentId })

                </div>

                <!-- ------------------------ SAĞ KOLON ------------------------ -->
                <aside class="appointment-detail-col" aria-label="Randevu yan bilgiler">

                    <!-- 7) RANDEVU BİLGİLERİ -->
                    @await Component.InvokeAsync("_AppointmentDetailInfosComponentPartial", new { id = (int)ViewBag.AppointmentId })


                    <!-- 8) KLİNİK BİLGİLERİ -->
                    <section class="card-ui" aria-label="Klinik bilgileri">
                        <div class="card-header-row">
                            <div class="card-header-title">
                                <div class="card-icon-tile is-info"><i class="bi bi-hospital"></i></div>
                                <h2 class="text-section-title">Klinik Bilgileri</h2>
                            </div>
                        </div>
                        <div class="appointment-detail-clinic">
                            <div class="appointment-detail-clinic-media" aria-hidden="true"><i class="bi bi-building"></i></div>
                            <div style="min-width:0;">
                                <div class="appointment-detail-clinic-name">VetCare Veteriner Kliniği</div>
                                <div class="appointment-detail-clinic-address">Atatürk Caddesi No:123<br>Ümraniye, İstanbul</div>
                                <a href="#" class="appointment-detail-clinic-phone"><i class="bi bi-telephone"></i> +90 216 123 45 67</a>
                            </div>
                        </div>
                        <button type="button" class="btn-ui btn-ui--ghost" style="width:100%; margin-top: 1rem;" data-toast="Harita bu prototipte pasif durumdadır."><i class="bi bi-geo-alt" style="color: var(--color-primary);"></i> Haritada Göster</button>
                    </section>

                    <!-- 9) HIZLI İŞLEMLER -->
                    <section class="card-ui appointment-detail-actions-card" aria-label="Hızlı işlemler">
                        <div class="card-header-row">
                            <div class="card-header-title">
                                <div class="card-icon-tile is-accent"><i class="bi bi-lightning-charge"></i></div>
                                <h2 class="text-section-title">Hızlı İşlemler</h2>
                            </div>
                        </div>
                        <div class="appointment-detail-actions">
                            <button type="button" class="btn-ui btn-ui--ghost" data-toast="Yeni randevu oluşturma bu prototipte pasif durumdadır."><i class="bi bi-calendar-plus"></i> Yeni Randevu Oluştur</button>
                            <button type="button" class="btn-ui btn-ui--ghost" data-toast="Aynı hekimden randevu alma bu prototipte pasif durumdadır."><i class="bi bi-person-check"></i> Aynı Hekimden Randevu Al</button>
                            <button type="button" class="btn-ui btn-ui--ghost" data-toast="PDF indirme bu prototipte pasif durumdadır."><i class="bi bi-download"></i> PDF Olarak İndir</button>
                            <button type="button" class="btn-ui btn-ui--ghost" id="printBtnSide"><i class="bi bi-printer"></i> Randevu Yazdır</button>
                        </div>
                    </section>

                    <!-- 10) SAHİP BİLGİLERİ -->
                    @await Component.InvokeAsync("_AppointmentDetailOwnerInfosComponentPartial", new { id = (int)ViewBag.AppointmentId })
                </aside>
            </div>

        </div>
    </main>

    <div class="appointment-toast-stack" id="appointmentToastStack" aria-live="polite"></div>

    <script>
            /* ==========================================================================
               JAVASCRIPT — yalnızca prototip davranışları. Backend/API çağrısı yoktur.
               ========================================================================== */

            (function () {
                'use strict';

                /* ---- Hayvan fotoğrafı: yüklenirse göster, yüklenemezse ikon fallback kalır ---- */
                var photo = document.getElementById('animalPhoto');
                var probe = new Image();
                probe.onload = function () {
                    photo.removeAttribute('style');
                    photo.parentNode.querySelector('.appointment-detail-photo-fallback').style.display = 'none';
                };
                probe.onerror = function () { photo.remove(); };
                probe.src = photo.getAttribute('src');

                /* ---- Toast ---- */
                var toastStack = document.getElementById('appointmentToastStack');

                function showToast(message) {
                    var toast = document.createElement('div');
                    toast.className = 'appointment-toast';
                    toast.setAttribute('role', 'status');
                    toast.innerHTML = '<i class="bi bi-info-circle-fill appointment-toast-icon"></i><span class="appointment-toast-message"></span>';
                    toast.querySelector('.appointment-toast-message').textContent = message;
                    toastStack.appendChild(toast);
                    var timer = setTimeout(function () { dismissToast(toast); }, 3000);
                    toast.dataset.timer = timer;
                }

                function dismissToast(toast) {
                    if (!toast || toast.classList.contains('is-leaving')) return;
                    clearTimeout(toast.dataset.timer);
                    toast.classList.add('is-leaving');
                    toast.addEventListener('animationend', function () { toast.remove(); }, { once: true });
                }

                document.querySelectorAll('[data-toast]').forEach(function (el) {
                    el.addEventListener('click', function () { showToast(el.getAttribute('data-toast')); });
                });

                /* ---- Sekmeler (yalnızca aktif görünüm değişir) ---- */
                var tabs = document.querySelectorAll('.appointment-detail-tab');
                tabs.forEach(function (tab) {
                    tab.addEventListener('click', function () {
                        tabs.forEach(function (t) { t.classList.remove('is-active'); t.setAttribute('aria-selected', 'false'); });
                        tab.classList.add('is-active');
                        tab.setAttribute('aria-selected', 'true');
                    });
                });

                /* ---- Mikroçip kopyalama ---- */
                document.getElementById('copyChipBtn').addEventListener('click', function () {
                    var value = '900164003215487';
                    if (navigator.clipboard && navigator.clipboard.writeText) {
                        navigator.clipboard.writeText(value).then(function () { showToast('Mikroçip numarası kopyalandı.'); }, function () { showToast('Kopyalanamadı.'); });
                    } else {
                        showToast('Kopyalama bu tarayıcıda desteklenmiyor.');
                    }
                });

                /* ---- Yazdır ---- */
                function doPrint() { window.print(); }
                document.getElementById('printBtn').addEventListener('click', doPrint);
                document.getElementById('printBtnSide').addEventListener('click', doPrint);
            })();
    </script>
</body>
</html>
