                .appointment-history-header,
                .appointment-history-row {
                    display: grid;
                    grid-template-columns: 1.1fr 1.4fr 1.2fr 1fr 0.9fr;
                    gap: 1rem;
                    align-items: center;
                    padding: 0.9rem 1.5rem;
                }

                .appointment-history-header {
                    background-color: var(--color-surface-alt);
                    border-bottom: 1px solid var(--color-border);
                }

                    .appointment-history-header span {
                        font-size: 0.7rem;
                        font-weight: 600;
                        text-transform: uppercase;
                        letter-spacing: 0.04em;
                        color: var(--color-muted-light);
                    }

                .appointment-history-row {
                    border-bottom: 1px solid var(--color-border);
                }

                    .appointment-history-row:last-child {
                        border-bottom: none;
                    }

                .appointment-history-cell-label {
                    display: none;
                    font-size: 0.65rem;
                    font-weight: 600;
                    text-transform: uppercase;
                    letter-spacing: 0.03em;
                    color: var(--color-muted-light);
                    margin-bottom: 3px;
                }

                .appointment-history-date-day {
                    font-size: 0.85rem;
                    font-weight: 600;
                    color: var(--color-text);
                }

                .appointment-history-date-time {
                    font-size: 0.75rem;
                    color: var(--color-muted-light);
                    margin-top: 1px;
                }

                .appointment-history-animal {
                    display: flex;
                    align-items: center;
                    gap: 10px;
                    min-width: 0;
                }

                .appointment-history-avatar {
                    flex: 0 0 auto;
                    width: 38px;
                    height: 38px;
                    border-radius: 50%;
                    overflow: hidden;
                    background: linear-gradient(135deg, var(--color-secondary-light) 0%, var(--color-primary-light) 100%);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    position: relative;
                }

                    .appointment-history-avatar img {
                        position: absolute;
                        inset: 0;
                        width: 100%;
                        height: 100%;
                        object-fit: cover;
                        z-index: 2;
                    }

                .appointment-history-avatar-fallback {
                    display: none;
                    position: absolute;
                    inset: 0;
                    align-items: center;
                    justify-content: center;
                    font-size: 0.9rem;
                    color: var(--color-primary);
                    opacity: 0.6;
                    z-index: 1;
                }

                .appointment-history-animal-name {
                    font-size: 0.85rem;
                    font-weight: 600;
                }

                .appointment-history-animal-breed {
                    font-size: 0.72rem;
                    color: var(--color-muted);
                }

                .appointment-history-type {
                    display: flex;
                    align-items: center;
                    gap: 8px;
                    font-size: 0.8125rem;
                    color: var(--color-text);
                }

                    .appointment-history-type i {
                        color: var(--color-primary);
                        font-size: 0.9rem;
                    }

                /* ==========================================================================
                                                                                                         EMPTY STATE (paylaşılan blok — hem yaklaşan hem geçmiş liste için)
                                                                                                         ========================================================================== */

                .appointment-empty-state {
                    display: none;
                    flex-direction: column;
                    align-items: center;
                    text-align: center;
                    gap: 0.5rem;
                    padding: 2.5rem 1rem;
                }

                    .appointment-empty-state.is-visible {
                        display: flex;
                    }

                    .appointment-empty-state i {
                        font-size: 2rem;
                        color: var(--color-muted-light);
                        margin-bottom: 0.25rem;
                    }

                /* ==========================================================================
                                                                                                         REMINDER CARD
                                                                                                         ========================================================================== */

                .appointment-reminder-card {
                    display: flex;
                    align-items: flex-start;
                    gap: 1rem;
                }

                .appointment-reminder-close {
                    flex: 0 0 auto;
                    width: 30px;
                    height: 30px;
                    border-radius: var(--radius-sm);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    color: var(--color-muted-light);
                    font-size: 0.9rem;
                    transition: background-color var(--transition-fast), color var(--transition-fast);
                }

                    .appointment-reminder-close:hover {
                        background-color: var(--color-surface-alt);
                        color: var(--color-text);
                    }

                /* ---- Toast (self-contained demo feedback) ---- */

                .appointment-toast-stack {
                    position: fixed;
                    top: 1.5rem;
                    right: 1.5rem;
                    z-index: 999;
                    display: flex;
                    flex-direction: column;
                    gap: 0.75rem;
                    width: min(340px, calc(100vw - 3rem));
                }

                .appointment-toast {
                    background-color: var(--color-surface);
                    border-radius: var(--radius-md);
                    box-shadow: var(--shadow-md);
                    border: 1px solid var(--color-border);
                    padding: 0.9rem 1rem;
                    display: flex;
                    align-items: flex-start;
                    gap: 0.65rem;
                    position: relative;
                    overflow: hidden;
                    animation: appointment-toast-in var(--transition-slow);
                }

                    .appointment-toast.is-leaving {
                        animation: appointment-toast-out var(--transition-base) forwards;
                    }

                    .appointment-toast::before {
                        content: "";
                        position: absolute;
                        left: 0;
                        top: 0;
                        bottom: 0;
                        width: 4px;
                        background-color: var(--color-primary);
                    }

                .appointment-toast-icon {
                    color: var(--color-primary);
                    font-size: 1.05rem;
                }

                .appointment-toast-message {
                    font-size: 0.8125rem;
                    color: var(--color-text);
                }

                @@keyframes appointment-toast-in {
                    from {
                        opacity: 0;
                        transform: translateX(20px);
                    }

                    to {
                        opacity: 1;
                        transform: translateX(0);
                    }
                }

                @@keyframes appointment-toast-out {
                    from {
                        opacity: 1;
                        transform: translateX(0);
                    }

                    to {
                        opacity: 0;
                        transform: translateX(20px);
                    }
                }

                /* ==========================================================================
                                                                                                         RESPONSIVE
                                                                                                         ========================================================================== */

                @@media (max-width: 1199.98px) {
                    .app-content {
                        padding: 1.75rem;
                    }

                    .appointment-stats {
                        grid-template-columns: repeat(2, 1fr);
                    }

                    .appointment-card-location {
                        display: none;
                    }
                }

                @@media (max-width: 991.98px) {
                    .appointment-history-header {
                        display: none;
                    }

                    .appointment-history-row {
                        grid-template-columns: 1fr;
                        gap: 0.6rem;
                        padding: 1rem 1.25rem;
                    }

                    .appointment-history-cell-label {
                        display: block;
                    }

                    .appointment-history-status,
                    .appointment-history-actions {
                        display: flex;
                        align-items: center;
                        gap: 8px;
                    }
                }

                @@media (max-width: 767.98px) {
                    .app-content {
                        padding: 1.25rem;
                    }

                    .appointment-stats {
                        grid-template-columns: 1fr 1fr;
                        gap: 0.85rem;
                    }

                    .appointment-page-header {
                        flex-direction: column;
                        align-items: stretch;
                    }

                        .appointment-page-header .btn-ui--primary {
                            width: 100%;
                        }

                    .appointment-filter-bar {
                        flex-direction: column;
                        align-items: stretch;
                    }

                    .appointment-filter-search, .appointment-filter-select {
                        flex: 1 1 auto;
                        width: 100%;
                    }

                    .appointment-card {
                        flex-direction: column;
                        align-items: stretch;
                    }

                    .appointment-card-date {
                        flex-direction: row;
                        justify-content: flex-start;
                        width: 100%;
                        gap: 0.75rem;
                    }

                    .appointment-card-media {
                        align-self: flex-start;
                    }

                    .appointment-card-animal {
                        flex-wrap: wrap;
                    }

                    .appointment-card-actions {
                        flex-direction: row;
                        width: 100%;
                    }

                        .appointment-card-actions .btn-ui {
                            justify-content: center;
                        }
                }

                @@media (max-width: 575.98px) {
                    .appointment-stats {
                        grid-template-columns: 1fr;
                    }

                    .appointment-card-actions {
                        flex-direction: column;
                    }
                }

        </style>


        <main class="app-content">
            <div class="app-content-inner">

                <!-- ==================================================================
           BREADCRUMB
           ================================================================== -->
                <nav class="breadcrumb-ui" aria-label="Breadcrumb">
                    <span class="breadcrumb-ui-item"><a href="#">Ana Sayfa</a></span>
                    <span class="breadcrumb-ui-sep"><i class="bi bi-chevron-right"></i></span>
                    <span class="breadcrumb-ui-item is-current">Randevularım</span>
                </nav>

                <!-- ==================================================================
           1) SAYFA HEADER
           ================================================================== -->
                <div class="section-header appointment-page-header">
                    <div class="section-header-text">
                        <h1 class="text-page-title">Randevularım</h1>
                        <p class="section-header-desc">Evcil dostlarınızın randevularını buradan takip edin.</p>
                    </div>
                    <a href="/appointment/create" class="btn-ui btn-ui--primary">
                        <i class="bi bi-plus-lg"></i> Yeni Randevu Oluştur
                    </a>
                </div>

                <!-- ==================================================================
           2) İSTATİSTİK KARTLARI — örnek/placeholder değerler
           ================================================================== -->
                @await Component.InvokeAsync("_AppointmentIndexStatisticsComponentPartial")

                <!-- ==================================================================
           3) FİLTRE VE ARAMA
           ================================================================== -->
                <section class="card-ui appointment-filter-bar" aria-label="Randevu filtreleri">
                    <div class="input-icon-wrap appointment-filter-search">
                        <i class="bi bi-search input-icon-wrap-icon" aria-hidden="true"></i>
                        <input type="search" id="appointmentSearchInput" class="form-control-ui" placeholder="Randevu ara..." aria-label="Randevu ara">
                    </div>
                    <div class="appointment-filter-select">
                        <select id="appointmentStatusFilter" class="form-control-ui" aria-label="Durum filtrele">
                            <option value="all">Tüm Durumlar</option>
                            <option value="Scheduled">Planlandı</option>
                            <option value="Completed">Tamamlandı</option>
                            <option value="Cancelled">İptal Edildi</option>
                        </select>
                    </div>
                    <div class="input-icon-wrap appointment-filter-select">
                        <i class="bi bi-calendar3 input-icon-wrap-icon" aria-hidden="true"></i>
                        <select id="appointmentDateFilter" class="form-control-ui" aria-label="Tarihe göre filtrele">
                            <option value="all">Tüm Tarihler</option>
                            <option value="week">Bu Hafta</option>
                            <option value="month">Bu Ay</option>
                            <option value="past">Geçmiş</option>
                        </select>
                    </div>
                    <div class="appointment-filter-select">
                        <select id="appointmentSortSelect" class="form-control-ui" aria-label="Sırala">
                            <option value="date-asc">Tarihe Göre (Yakın)</option>
                            <option value="date-desc">Tarihe Göre (Uzak)</option>
                            <option value="status">Duruma Göre</option>
                        </select>
                    </div>
                </section>

                <!-- ==================================================================
           4) YAKLAŞAN RANDEVULAR
           ================================================================== -->
                @await Component.InvokeAsync("_AppointmentIndexUpcomingAppointmentsComponentPartial")


                <!-- ==================================================================
           5) GEÇMİŞ RANDEVULAR
           Her ".appointment-history-row" bir randevu öğesidir — gerçek veri
           bağlanırken bu blok bir foreach şablonu olarak kullanılmalı.
           ================================================================== -->
                @await Component.InvokeAsync("_AppointmentIndexPastAppointmentsComponentPartial")

                <!-- ==================================================================
           6) ALT BİLGİ / HATIRLATMA
           ================================================================== -->
                <div class="card-ui appointment-reminder-card" id="reminderCard">
                    <div class="card-icon-tile is-primary"><i class="bi bi-suit-heart"></i></div>
                    <div style="flex: 1 1 auto;">
                        <h3 class="text-card-title">Hatırlatma</h3>
                        <p class="text-small text-muted" style="margin-top: 4px;">Randevunuzdan önce evcil hayvanınızın temel bilgilerini güncel tutmayı unutmayın. Bu, daha doğru bir değerlendirme yapılmasına yardımcı olur.</p>
                    </div>
                    <button type="button" class="appointment-reminder-close" id="reminderCloseBtn" aria-label="Hatırlatmayı kapat">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>

            </div>
        </main>

        <div class="appointment-toast-stack" id="appointmentToastStack" aria-live="polite"></div>

        <script>
                /* ==========================================================================
                   JAVASCRIPT — yalnızca sayfaya özel prototip davranışları.
                   Gerçek API çağrısı / silme / iptal işlemi yoktur.
                   ========================================================================== */

                (function () {
                  'use strict';

                  /* ---- Kırık görsel geri dönüşü (thumbnail'ler için ek güvence) ---- */
                  document.querySelectorAll('.appointment-card-media img, .appointment-history-avatar img').forEach(function (img) {
                    img.addEventListener('error', function () { img.remove(); }, { once: true });
                  });

                  /* ---- Basit self-contained toast ---- */
                  var toastStack = document.getElementById('appointmentToastStack');

                  function showToast(message) {
                    var toast = document.createElement('div');
                    toast.className = 'appointment-toast';
                    toast.setAttribute('role', 'status');
                    toast.innerHTML = '<i class="bi bi-info-circle-fill appointment-toast-icon"></i><span class="appointment-toast-message"></span>';
                    toast.querySelector('.appointment-toast-message').textContent = message;
                    toastStack.appendChild(toast);
                    var timer = setTimeout(function () { dismissToast(toast); }, 3200);
                    toast.dataset.timer = timer;
                  }

                  function dismissToast(toast) {
                    if (!toast || toast.classList.contains('is-leaving')) return;
                    clearTimeout(toast.dataset.timer);
                    toast.classList.add('is-leaving');
                    toast.addEventListener('animationend', function () { toast.remove(); }, { once: true });
                  }

                  document.getElementById('createAppointmentBtn').addEventListener('click', function (e) {
                    e.preventDefault();
                    showToast('Yeni randevu oluşturma bu prototipte pasif durumdadır.');
                  });

                  document.querySelectorAll('[data-cancel-appointment]').forEach(function (btn) {
                    btn.addEventListener('click', function () {
                      showToast('Randevu iptali bu prototipte pasif durumdadır.');
                    });
                  });

                  /* ---- Hatırlatma kartını kapatma ---- */
                  var reminderCard = document.getElementById('reminderCard');
                  document.getElementById('reminderCloseBtn').addEventListener('click', function () {
                    reminderCard.style.display = 'none';
                  });

                  /* ---- Arama / filtre / sıralama (yalnızca yaklaşan randevu listesi üzerinde demo) ---- */
                  var searchInput = document.getElementById('appointmentSearchInput');
                  var statusFilter = document.getElementById('appointmentStatusFilter');
                  var sortSelect = document.getElementById('appointmentSortSelect');
                  var upcomingList = document.getElementById('upcomingAppointmentList');

                  function normalize(value) {
                    return (value || '').toLocaleLowerCase('tr-TR').trim();
                  }

                  function applyUpcomingFilters() {
                    if (!upcomingList) return;
                    var query = normalize(searchInput.value);
                    var status = statusFilter.value;

                    upcomingList.querySelectorAll('.appointment-card').forEach(function (card) {
                      var matchesQuery = !query || normalize(card.dataset.name).indexOf(query) !== -1;
                      var matchesStatus = status === 'all' || card.dataset.status === status;
                      card.hidden = !(matchesQuery && matchesStatus);
                    });
                  }

                  function applyUpcomingSort() {
                    if (!upcomingList) return;
                    var cards = Array.prototype.slice.call(upcomingList.querySelectorAll('.appointment-card'));
                    var mode = sortSelect.value;

                    cards.sort(function (a, b) {
                      if (mode === 'date-desc') return b.dataset.date.localeCompare(a.dataset.date);
                      if (mode === 'status') return a.dataset.status.localeCompare(b.dataset.status);
                      return a.dataset.date.localeCompare(b.dataset.date);
                    });

                    cards.forEach(function (card) { upcomingList.appendChild(card); });
                  }

                  if (searchInput) searchInput.addEventListener('input', applyUpcomingFilters);
                  if (statusFilter) statusFilter.addEventListener('change', applyUpcomingFilters);
                  if (sortSelect) sortSelect.addEventListener('change', applyUpcomingSort);
                })();
        </script>
}

