    </head>


    <body>


        <main class="manager-appointment-page">


            <!-- =========================================================
         PAGE HEADER
         ========================================================= -->

            <section class="manager-appointment-header">

                <div class="manager-appointment-header-left">

                    <div class="manager-appointment-header-icon">

                        <i class="fa-solid fa-calendar-check"></i>

                    </div>

                    <div>

                        <h1 class="manager-appointment-title">
                            Randevular
                        </h1>

                        <p class="manager-appointment-subtitle">
                            Kliniğinizdeki randevuları görüntüleyin,
                            yönetin ve takip edin.
                        </p>

                    </div>

                </div>


                <a href="/Appointment/Create"
                   class="btn-ui btn-ui--primary">

                    <i class="fa-solid fa-plus"></i>

                    Yeni Randevu

                </a>

            </section>


            <!-- =========================================================
         STATISTICS
         ========================================================= -->
            @await Component.InvokeAsync("_ManagerAppointmentIndexStatisticsComponentPartial")


            <!-- =========================================================
         UPCOMING APPOINTMENTS
         ========================================================= -->
            @await Component.InvokeAsync("_ManagerAppointmentIndexUpcomingAppointmentsComponentPartial")



            <!-- =========================================================
         TODAY
         ========================================================= -->
            @await Component.InvokeAsync("_ManagerAppointmentTodayAppointmentsComponentPartial")



            <!-- =========================================================
         ALL APPOINTMENTS
         ========================================================= -->
            @await Component.InvokeAsync("_ManagerAppointmentAllAppointmentsComponentPartial")

        </main>


        <!-- =========================================================
     SIMPLE TAB / DEMO INTERACTION
     ========================================================= -->

        <script>

                // =========================================================
                // UPCOMING APPOINTMENTS SLIDER
                // =========================================================

                const upcomingSlider =
                    document.querySelector(".manager-appointment-slider");

                const upcomingTrack =
                    document.getElementById("upcomingAppointmentTrack");

                const upcomingPrev =
                    document.getElementById("upcomingPrev");

                const upcomingNext =
                    document.getElementById("upcomingNext");


                // Gerekli elementler yoksa JS'i çalıştırma
                if (
                    upcomingSlider &&
                    upcomingTrack &&
                    upcomingPrev &&
                    upcomingNext
                ) {

                    let upcomingCurrentIndex = 0;


                    // ---------------------------------------------------------
                    // Ekrana göre kaç kart gösterilecek?
                    // ---------------------------------------------------------

                    function getVisibleCards() {

                        if (window.innerWidth <= 768) {
                            return 1;
                        }

                        if (window.innerWidth <= 1200) {
                            return 2;
                        }

                        return 4;
                    }


                    // ---------------------------------------------------------
                    // Kartlar arasındaki boşluk
                    // ---------------------------------------------------------

                    function getCardGap() {

                        return 16;

                    }


                    // ---------------------------------------------------------
                    // Slider güncelle
                    // ---------------------------------------------------------

                    function updateUpcomingSlider() {

                        const cards =
                            upcomingTrack.querySelectorAll(
                                ".manager-appointment-card"
                            );


                        const visibleCards =
                            getVisibleCards();


                        const totalCards =
                            cards.length;


                        const maxIndex =
                            Math.max(
                                0,
                                totalCards - visibleCards
                            );


                        if (upcomingCurrentIndex > maxIndex) {

                            upcomingCurrentIndex =
                                maxIndex;

                        }


                        const card =
                            cards[0];


                        if (!card) {

                            upcomingPrev.disabled = true;
                            upcomingNext.disabled = true;

                            return;

                        }


                        const cardWidth =
                            card.getBoundingClientRect().width;


                        const gap =
                            getCardGap();


                        const translateX =
                            upcomingCurrentIndex *
                            (cardWidth + gap);


                        upcomingTrack.style.transform =
                            `translateX(-${translateX}px)`;


                        // -----------------------------------------------------
                        // Okların aktif/pasif durumu
                        // -----------------------------------------------------

                        upcomingPrev.disabled =
                            upcomingCurrentIndex === 0;


                        upcomingNext.disabled =
                            upcomingCurrentIndex >= maxIndex;

                    }


                    // ---------------------------------------------------------
                    // SAĞ OK
                    // ---------------------------------------------------------

                    upcomingNext.addEventListener(
                        "click",
                        function () {

                            const cards =
                                upcomingTrack.querySelectorAll(
                                    ".manager-appointment-card"
                                );


                            const visibleCards =
                                getVisibleCards();


                            const maxIndex =
                                Math.max(
                                    0,
                                    cards.length - visibleCards
                                );


                            if (
                                upcomingCurrentIndex <
                                maxIndex
                            ) {

                                upcomingCurrentIndex++;

                                updateUpcomingSlider();

                            }

                        }
                    );


                    // ---------------------------------------------------------
                    // SOL OK
                    // ---------------------------------------------------------

                    upcomingPrev.addEventListener(
                        "click",
                        function () {

                            if (
                                upcomingCurrentIndex >
                                0
                            ) {

                                upcomingCurrentIndex--;

                                updateUpcomingSlider();

                            }

                        }
                    );


                    // ---------------------------------------------------------
                    // EKRAN BOYUTU DEĞİŞİNCE
                    // ---------------------------------------------------------

                    window.addEventListener(
                        "resize",
                        function () {

                            updateUpcomingSlider();

                        }
                    );


                    // ---------------------------------------------------------
                    // İLK ÇALIŞTIRMA
                    // ---------------------------------------------------------

                    updateUpcomingSlider();

                }

        </script>

    </body>

</html>
}

