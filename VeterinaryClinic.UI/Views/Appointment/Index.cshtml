@if (User.IsInRole("Manager"))
{
    <!DOCTYPE html>
    <html lang="tr">

    <head>

        <meta charset="UTF-8">

        <meta name="viewport"
              content="width=device-width, initial-scale=1.0">

        <title>Randevular | VetCare</title>


        <!-- =========================================================
         FONT AWESOME
         ========================================================= -->

        <link rel="stylesheet"
              href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.0/css/all.min.css">

        <style>
                /* =========================================================
                   MANAGER APPOINTMENT PAGE
                   ========================================================= */

                .manager-appointment-page {
                    width: 100%;
                    display: flex;
                    flex-direction: column;
                    gap: 28px;
                    padding: 4px 0 32px;
                    color: var(--color-text);
                }


                    /* =========================================================
                   PAGE HEADER
                   ========================================================= */

                    .manager-appointment-page .manager-appointment-header {
                        display: flex;
                        align-items: center;
                        justify-content: space-between;
                        gap: 24px;
                    }


                    .manager-appointment-page .manager-appointment-header-left {
                        display: flex;
                        align-items: center;
                        gap: 16px;
                    }


                    .manager-appointment-page .manager-appointment-header-icon {
                        width: 54px;
                        height: 54px;
                        min-width: 54px;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        border-radius: 16px;
                        background: var(--color-primary-light);
                        color: var(--color-primary);
                        font-size: 1.25rem;
                    }


                    .manager-appointment-page .manager-appointment-title {
                        margin: 0;
                        font-size: 1.65rem;
                        font-weight: 700;
                        line-height: 1.2;
                        color: var(--color-text);
                    }


                    .manager-appointment-page .manager-appointment-subtitle {
                        margin: 6px 0 0;
                        font-size: 0.84rem;
                        line-height: 1.5;
                        color: var(--color-muted);
                    }


                    /* =========================================================
                   STATISTICS
                   ========================================================= */

                    .manager-appointment-page .manager-appointment-stat-grid {
                        width: 100%;
                        display: grid;
                        grid-template-columns: repeat(4, minmax(0, 1fr));
                        gap: 16px;
                    }


                    .manager-appointment-page .manager-appointment-stat-card {
                        position: relative;
                        min-height: 132px;
                        padding: 20px;
                        display: flex;
                        flex-direction: column;
                        justify-content: space-between;
                        background: var(--color-surface);
                        border: 1px solid var(--color-border);
                        border-radius: 16px;
                        box-shadow: var(--shadow-sm);
                        overflow: hidden;
                    }


                        .manager-appointment-page .manager-appointment-stat-card::after {
                            content: "";
                            position: absolute;
                            width: 90px;
                            height: 90px;
                            right: -30px;
                            bottom: -35px;
                            border-radius: 50%;
                            background: var(--color-primary-light);
                            opacity: 0.45;
                        }


                    .manager-appointment-page .manager-appointment-stat-top {
                        position: relative;
                        z-index: 1;
                        display: flex;
                        align-items: flex-start;
                        justify-content: space-between;
                        gap: 12px;
                    }


                    .manager-appointment-page .manager-appointment-stat-label {
                        display: block;
                        font-size: 0.76rem;
                        font-weight: 600;
                        color: var(--color-muted);
                    }


                    .manager-appointment-page .manager-appointment-stat-value {
                        display: block;
                        margin-top: 10px;
                        font-size: 1.75rem;
                        font-weight: 700;
                        line-height: 1;
                        color: var(--color-text);
                    }


                    .manager-appointment-page .manager-appointment-stat-icon {
                        width: 42px;
                        height: 42px;
                        min-width: 42px;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        border-radius: 12px;
                        font-size: 0.95rem;
                    }


                        .manager-appointment-page
                        .manager-appointment-stat-icon.primary {
                            background: var(--color-primary-light);
                            color: var(--color-primary);
                        }


                        .manager-appointment-page
                        .manager-appointment-stat-icon.info {
                            background: #eef6fb;
                            color: var(--color-info);
                        }


                        .manager-appointment-page
                        .manager-appointment-stat-icon.success {
                            background: #eef8f1;
                            color: var(--color-success);
                        }


                        .manager-appointment-page
                        .manager-appointment-stat-icon.danger {
                            background: #fdf0f2;
                            color: var(--color-danger);
                        }


                    .manager-appointment-page .manager-appointment-stat-description {
                        position: relative;
                        z-index: 1;
                        font-size: 0.7rem;
                        color: var(--color-muted);
                    }


                    /* =========================================================
                   SECTION
                   ========================================================= */

                    .manager-appointment-page .manager-appointment-section {
                        width: 100%;
                        display: flex;
                        flex-direction: column;
                        gap: 16px;
                    }


                    .manager-appointment-page .manager-appointment-section-header {
                        display: flex;
                        align-items: center;
                        justify-content: space-between;
                        gap: 16px;
                    }


                    .manager-appointment-page .manager-appointment-section-title {
                        margin: 0;
                        font-size: 1rem;
                        font-weight: 700;
                        color: var(--color-text);
                    }


                    .manager-appointment-page .manager-appointment-section-description {
                        margin: 4px 0 0;
                        font-size: 0.74rem;
                        color: var(--color-muted);
                    }


                    .manager-appointment-page .manager-appointment-section-action {
                        display: inline-flex;
                        align-items: center;
                        gap: 6px;
                        color: var(--color-primary);
                        font-size: 0.75rem;
                        font-weight: 600;
                        text-decoration: none;
                    }


                        .manager-appointment-page
                        .manager-appointment-section-action:hover {
                            color: var(--color-primary-dark);
                        }


                    /* =========================================================
                   UPCOMING APPOINTMENT SLIDER
                   ========================================================= */

                    .manager-appointment-page
                    .manager-appointment-slider {
                        position: relative;
                        width: 100%;
                    }


                    .manager-appointment-page
                    .manager-appointment-slider-viewport {
                        width: 100%;
                        overflow: hidden;
                    }


                    .manager-appointment-page
                    .manager-appointment-cards {
                        display: flex;
                        gap: 16px;
                        width: 100%;
                        transition: transform 0.35s ease;
                    }


                    /* =========================================================
                   UPCOMING APPOINTMENT CARD
                   ========================================================= */

                    .manager-appointment-page
                    .manager-appointment-card {
                        position: relative;
                        flex: 0 0 calc((100% - 48px) / 4);
                        width: calc((100% - 48px) / 4);
                        min-width: 0;
                        display: flex;
                        flex-direction: column;
                        padding: 18px;
                        background: var(--color-surface);
                        border: 1px solid var(--color-border);
                        border-radius: 16px;
                        box-shadow: var(--shadow-sm);
                        overflow: hidden;
                        transition: transform var(--transition-fast), box-shadow var(--transition-fast), border-color var(--transition-fast);
                    }


                        .manager-appointment-page
                        .manager-appointment-card:hover {
                            transform: translateY(-2px);
                            border-color: var(--color-border-strong);
                            box-shadow: var(--shadow-md);
                        }


                    /* =========================================================
                   CARD STATUS
                   ========================================================= */

                    .manager-appointment-page
                    .manager-appointment-card-status {
                        display: flex;
                        align-items: center;
                        justify-content: space-between;
                        gap: 8px;
                        margin-bottom: 16px;
                    }


                    .manager-appointment-page
                    .manager-appointment-card-status-date {
                        font-size: 0.68rem;
                        font-weight: 600;
                        color: var(--color-muted);
                    }


                    /* =========================================================
                   CARD ANIMAL
                   ========================================================= */

                    .manager-appointment-page
                    .manager-appointment-card-animal {
                        display: flex;
                        align-items: center;
                        gap: 12px;
                        margin-bottom: 16px;
                    }


                    .manager-appointment-page
                    .manager-appointment-card-animal-image {
                        width: 48px;
                        height: 48px;
                        min-width: 48px;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        overflow: hidden;
                        border-radius: 50%;
                        background: var(--color-primary-light);
                        color: var(--color-primary);
                    }


                        .manager-appointment-page
                        .manager-appointment-card-animal-image img {
                            width: 100%;
                            height: 100%;
                            object-fit: cover;
                            display: block;
                        }


                    .manager-appointment-page
                    .manager-appointment-card-animal-name {
                        display: block;
                        font-size: 0.9rem;
                        font-weight: 700;
                        color: var(--color-text);
                    }


                    .manager-appointment-page
                    .manager-appointment-card-type {
                        display: block;
                        margin-top: 4px;
                        font-size: 0.7rem;
                        color: var(--color-muted);
                    }


                    /* =========================================================
                   CARD INFO
                   ========================================================= */

                    .manager-appointment-page
                    .manager-appointment-card-info {
                        display: grid;
                        grid-template-columns: 1fr 1fr;
                        gap: 12px;
                        padding: 12px 0;
                        margin-bottom: 14px;
                        border-top: 1px solid var(--color-border);
                        border-bottom: 1px solid var(--color-border);
                    }


                    .manager-appointment-page
                    .manager-appointment-card-info-item {
                        display: flex;
                        flex-direction: column;
                        gap: 4px;
                    }


                    .manager-appointment-page
                    .manager-appointment-card-info-label {
                        font-size: 0.63rem;
                        color: var(--color-muted);
                    }


                    .manager-appointment-page
                    .manager-appointment-card-info-value {
                        font-size: 0.72rem;
                        font-weight: 600;
                        color: var(--color-text);
                    }


                    /* =========================================================
                   CARD CUSTOMER
                   ========================================================= */

                    .manager-appointment-page
                    .manager-appointment-card-customer {
                        display: flex;
                        align-items: center;
                        gap: 7px;
                        margin-bottom: 16px;
                        font-size: 0.7rem;
                        color: var(--color-muted);
                    }


                        .manager-appointment-page
                        .manager-appointment-card-customer i {
                            color: var(--color-primary);
                        }


                    /* =========================================================
                   CARD ACTIONS
                   ========================================================= */

                   .manager-appointment-card-actions {
                        display: grid;
                        grid-template-columns: 1fr 1fr;
                        gap: 0.5rem;
                    }

                    /* Genel action */
                    .manager-appointment-card-action {
                        display: inline-flex;
                        align-items: center;
                        justify-content: center;
                        gap: 0.45rem;

                        min-height: 36px;
                        padding: 0.55rem 0.8rem;

                        border: 1px solid var(--color-border);
                        border-radius: var(--radius-md);

                        background-color: transparent;
                        color: var(--color-muted);

                        font-size: 0.78rem;
                        font-weight: 600;
                        text-decoration: none;

                        transition:
                            background-color var(--transition-fast),
                            border-color var(--transition-fast),
                            color var(--transition-fast);
                    }

                    .manager-appointment-card-action:hover {
                        background-color: var(--color-surface-alt);
                        color: var(--color-text);
                    }

                    /* Düzenle */
                    .manager-appointment-card-action.primary {
                        background-color: var(--color-primary);
                        border-color: var(--color-primary);
                        color: #ffffff;
                    }

                    .manager-appointment-card-action.primary:hover {
                        background-color: var(--color-primary-dark);
                        border-color: var(--color-primary-dark);
                        color: #ffffff;
                    }

                    /* İptal Et */
                    .manager-appointment-card-action.cancel {
                        grid-column: 1 / -1;

                        background-color: transparent;
                        border-color: var(--color-danger);
                        color: var(--color-danger);
                    }

                    .manager-appointment-card-action.cancel:hover {
                        background-color: #fff1f3;
                        border-color: var(--color-danger);
                        color: var(--color-danger);
                    }


                    /* =========================================================
                   SLIDER ARROWS
                   ========================================================= */

                    .manager-appointment-page
                    .manager-appointment-slider-arrow {
                        position: absolute;
                        top: 50%;
                        transform: translateY(-50%);
                        z-index: 10;
                        width: 38px;
                        height: 38px;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        border: 1px solid var(--color-border);
                        border-radius: 50%;
                        background: var(--color-surface);
                        color: var(--color-text);
                        box-shadow: var(--shadow-sm);
                        cursor: pointer;
                        transition: background-color var(--transition-fast), border-color var(--transition-fast), color var(--transition-fast), transform var(--transition-fast);
                    }


                        .manager-appointment-page
                        .manager-appointment-slider-arrow:hover {
                            background: var(--color-primary);
                            border-color: var(--color-primary);
                            color: #ffffff;
                            transform: translateY(-50%) scale(1.05);
                        }


                        .manager-appointment-page
                        .manager-appointment-slider-arrow:disabled {
                            opacity: 0.35;
                            cursor: default;
                            pointer-events: none;
                        }


                        .manager-appointment-page
                        .manager-appointment-slider-arrow.prev {
                            left: -18px;
                        }


                        .manager-appointment-page
                        .manager-appointment-slider-arrow.next {
                            right: -18px;
                        }


                    /* =========================================================
                   TODAY'S APPOINTMENTS
                   ========================================================= */

                    .manager-appointment-page
                    .manager-today-wrapper {
                        display: flex;
                        flex-direction: column;
                        gap: 10px;
                        padding: 18px;
                        background: var(--color-surface);
                        border: 1px solid var(--color-border);
                        border-radius: 16px;
                        box-shadow: var(--shadow-sm);
                    }


                    .manager-appointment-page
                    .manager-today-row {
                        display: grid;
                        grid-template-columns: 72px minmax(170px, 1fr) minmax(150px, 0.8fr) 140px 100px 110px;
                        align-items: center;
                        gap: 16px;
                        min-height: 72px;
                        padding: 12px 14px;
                        border: 1px solid transparent;
                        border-radius: 12px;
                        transition: background-color var(--transition-fast), border-color var(--transition-fast);
                    }


                        .manager-appointment-page
                        .manager-today-row:hover {
                            background: var(--color-surface-alt);
                            border-color: var(--color-border);
                        }


                    /* =========================================================
                   TODAY TIME
                   ========================================================= */

                    .manager-appointment-page
                    .manager-today-time {
                        display: flex;
                        flex-direction: column;
                        gap: 3px;
                    }


                        .manager-appointment-page
                        .manager-today-time strong {
                            font-size: 0.84rem;
                            color: var(--color-text);
                        }


                        .manager-appointment-page
                        .manager-today-time span {
                            font-size: 0.64rem;
                            color: var(--color-muted);
                        }


                    /* =========================================================
                   TODAY ANIMAL
                   ========================================================= */

                    .manager-appointment-page
                    .manager-today-animal {
                        display: flex;
                        align-items: center;
                        gap: 10px;
                    }


                    .manager-appointment-page
                    .manager-today-avatar {
                        width: 38px;
                        height: 38px;
                        min-width: 38px;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        overflow: hidden;
                        border-radius: 50%;
                        background: var(--color-primary-light);
                        color: var(--color-primary);
                    }


                        .manager-appointment-page
                        .manager-today-avatar img {
                            width: 100%;
                            height: 100%;
                            object-fit: cover;
                        }


                    .manager-appointment-page
                    .manager-today-animal-info {
                        display: flex;
                        flex-direction: column;
                        gap: 3px;
                    }


                    .manager-appointment-page
                    .manager-today-animal-name {
                        font-size: 0.78rem;
                        font-weight: 700;
                        color: var(--color-text);
                    }


                    .manager-appointment-page
                    .manager-today-animal-meta {
                        font-size: 0.64rem;
                        color: var(--color-muted);
                    }


                    /* =========================================================
                   TODAY OWNER
                   ========================================================= */

                    .manager-appointment-page
                    .manager-today-owner {
                        display: flex;
                        flex-direction: column;
                        gap: 3px;
                    }


                    .manager-appointment-page
                    .manager-today-owner-label {
                        font-size: 0.62rem;
                        color: var(--color-muted);
                    }


                    .manager-appointment-page
                    .manager-today-owner-name {
                        font-size: 0.73rem;
                        font-weight: 600;
                        color: var(--color-text);
                    }


                    /* =========================================================
                   TODAY TYPE
                   ========================================================= */

                    .manager-appointment-page
                    .manager-today-type {
                        font-size: 0.7rem;
                        color: var(--color-muted);
                    }


                    .manager-appointment-page
                    .manager-today-status {
                        display: flex;
                        justify-content: flex-start;
                    }


                    .manager-appointment-page
                    .manager-today-action {
                        display: flex;
                        justify-content: flex-end;
                    }


                    /* =========================================================
                   TODAY VIEW BUTTON
                   ========================================================= */

                    .manager-appointment-page
                    .manager-today-view {
                        width: 34px;
                        height: 34px;
                        display: inline-flex;
                        align-items: center;
                        justify-content: center;
                        border: 1px solid var(--color-border);
                        border-radius: var(--radius-sm);
                        background: var(--color-surface);
                        color: var(--color-muted);
                        text-decoration: none;
                        transition: color var(--transition-fast), border-color var(--transition-fast), background-color var(--transition-fast);
                    }


                        .manager-appointment-page
                        .manager-today-view:hover {
                            color: var(--color-primary);
                            border-color: var(--color-primary);
                            background: var(--color-primary-light);
                        }


                    /* =========================================================
                   ALL APPOINTMENTS
                   ========================================================= */

                    .manager-appointment-page
                    .manager-all-appointments {
                        display: flex;
                        flex-direction: column;
                        background: var(--color-surface);
                        border: 1px solid var(--color-border);
                        border-radius: 16px;
                        box-shadow: var(--shadow-sm);
                        overflow: hidden;
                    }


                    .manager-appointment-page
                    .manager-all-header {
                        display: flex;
                        align-items: center;
                        justify-content: space-between;
                        gap: 16px;
                        padding: 18px 20px;
                        border-bottom: 1px solid var(--color-border);
                    }


                    .manager-appointment-page
                    .manager-all-header-left {
                        display: flex;
                        align-items: center;
                        gap: 10px;
                    }


                    .manager-appointment-page
                    .manager-all-header-title {
                        margin: 0;
                        font-size: 0.92rem;
                        font-weight: 700;
                    }


                    .manager-appointment-page
                    .manager-all-filter {
                        display: flex;
                        align-items: center;
                        gap: 8px;
                    }


                    .manager-appointment-page
                    .manager-all-select {
                        height: 36px;
                        padding: 0 10px;
                        border: 1px solid var(--color-border-strong);
                        border-radius: var(--radius-sm);
                        background: var(--color-surface);
                        color: var(--color-text);
                        font-family: inherit;
                        font-size: 0.7rem;
                        outline: none;
                    }


                    /* =========================================================
                   ALL APPOINTMENTS TABLE
                   ========================================================= */

                    .manager-appointment-page
                    .manager-all-table-wrapper {
                        width: 100%;
                        overflow-x: auto;
                    }


                    .manager-appointment-page
                    .manager-all-table {
                        width: 100%;
                        min-width: 900px;
                        border-collapse: collapse;
                    }


                        .manager-appointment-page
                        .manager-all-table th {
                            padding: 12px 16px;
                            background: var(--color-surface-alt);
                            border-bottom: 1px solid var(--color-border);
                            color: var(--color-muted);
                            font-size: 0.67rem;
                            font-weight: 700;
                            text-align: left;
                            white-space: nowrap;
                        }


                        .manager-appointment-page
                        .manager-all-table td {
                            padding: 14px 16px;
                            border-bottom: 1px solid var(--color-border);
                            font-size: 0.72rem;
                            vertical-align: middle;
                        }


                        .manager-appointment-page
                        .manager-all-table tr:last-child td {
                            border-bottom: 0;
                        }


                        .manager-appointment-page
                        .manager-all-table tbody tr:hover {
                            background: var(--color-surface-alt);
                        }


                    /* =========================================================
                   TABLE DATE
                   ========================================================= */

                    .manager-appointment-page
                    .manager-table-date {
                        display: flex;
                        flex-direction: column;
                        gap: 3px;
                    }


                        .manager-appointment-page
                        .manager-table-date strong {
                            font-size: 0.73rem;
                        }


                        .manager-appointment-page
                        .manager-table-date span {
                            font-size: 0.64rem;
                            color: var(--color-muted);
                        }


                    /* =========================================================
                   TABLE PET
                   ========================================================= */

                    .manager-appointment-page
                    .manager-table-pet {
                        display: flex;
                        align-items: center;
                        gap: 8px;
                    }


                    .manager-appointment-page
                    .manager-table-pet-icon {
                        width: 32px;
                        height: 32px;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        border-radius: 50%;
                        background: var(--color-primary-light);
                        color: var(--color-primary);
                    }


                    .manager-appointment-page
                    .manager-table-pet-name {
                        display: flex;
                        flex-direction: column;
                        gap: 2px;
                    }


                        .manager-appointment-page
                        .manager-table-pet-name strong {
                            font-size: 0.72rem;
                        }


                        .manager-appointment-page
                        .manager-table-pet-name span {
                            font-size: 0.62rem;
                            color: var(--color-muted);
                        }


                    /* =========================================================
                   TABLE ACTIONS
                   ========================================================= */

                    .manager-appointment-page
                    .manager-table-actions {
                        display: flex;
                        justify-content: flex-end;
                        gap: 6px;
                    }


                    .manager-appointment-page
                    .manager-table-action {
                        width: 32px;
                        height: 32px;
                        display: inline-flex;
                        align-items: center;
                        justify-content: center;
                        border: 1px solid var(--color-border);
                        border-radius: var(--radius-sm);
                        background: var(--color-surface);
                        color: var(--color-muted);
                        text-decoration: none;
                        transition: color var(--transition-fast), border-color var(--transition-fast), background-color var(--transition-fast);
                    }


                        .manager-appointment-page
                        .manager-table-action:hover {
                            color: var(--color-primary);
                            border-color: var(--color-primary);
                            background: var(--color-primary-light);
                        }


                /* =========================================================
                   RESPONSIVE - TABLET
                   ========================================================= */

                @@media (max-width: 1200px) {
                    /* Statistics */

                    .manager-appointment-page
                    .manager-appointment-stat-grid {
                        grid-template-columns: repeat(2, minmax(0, 1fr));
                    }
                    /* Slider */

                    .manager-appointment-page
                    .manager-appointment-card {
                        flex: 0 0 calc((100% - 16px) / 2);
                        width: calc((100% - 16px) / 2);
                    }
                    /* Today's appointments */

                    .manager-appointment-page
                    .manager-today-row {
                        grid-template-columns: 70px minmax(150px, 1fr) minmax(130px, 0.8fr) 120px 100px 50px;
                    }
                }


                /* =========================================================
                   RESPONSIVE - MOBILE
                   ========================================================= */

                @@media (max-width: 768px) {


                    .manager-appointment-page {
                        gap: 22px;
                    }
                        /* Header */

                        .manager-appointment-page
                        .manager-appointment-header {
                            align-items: flex-start;
                            flex-direction: column;
                        }


                            .manager-appointment-page
                            .manager-appointment-header
                            .btn-ui {
                                width: 100%;
                            }
                        /* Statistics */

                        .manager-appointment-page
                        .manager-appointment-stat-grid {
                            grid-template-columns: 1fr;
                        }
                        /* Slider */

                        .manager-appointment-page
                        .manager-appointment-card {
                            flex: 0 0 100%;
                            width: 100%;
                        }
                        /* Slider arrows */

                        .manager-appointment-page
                        .manager-appointment-slider-arrow.prev {
                            left: 8px;
                        }


                        .manager-appointment-page
