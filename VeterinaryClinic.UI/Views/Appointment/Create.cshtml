@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if(User.IsInRole("Manager"))
{
    <style>

        /* =========================================================
                                   APPOINTMENT CREATE PAGE
                                   ========================================================= */

        .manager-appointment-create-page {
            width: 100%;
            display: flex;
            flex-direction: column;
            gap: 24px;
            padding: 4px 0 32px;
            color: var(--color-text);
        }


        /* =========================================================
                                   PAGE HEADER
                                   ========================================================= */

        .manager-appointment-create-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 24px;
        }

        .manager-appointment-create-header-left {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .manager-appointment-create-header-icon {
            width: 54px;
            height: 54px;
            min-width: 54px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 16px;
            background: var(--color-primary-light);
            color: var(--color-primary);
            font-size: 1.2rem;
        }

        .manager-appointment-create-title {
            margin: 0;
            font-size: 1.65rem;
            font-weight: 700;
            line-height: 1.2;
            color: var(--color-text);
        }

        .manager-appointment-create-subtitle {
            margin: 6px 0 0;
            font-size: 0.84rem;
            line-height: 1.5;
            color: var(--color-muted);
        }


        /* =========================================================
                                   PAGE CONTENT
                                   ========================================================= */

        .manager-appointment-create-content {
            display: grid;
            grid-template-columns: minmax(0, 1.65fr) minmax(300px, 0.85fr);
            gap: 20px;
            align-items: start;
        }


        /* =========================================================
                                   FORM CARD
                                   ========================================================= */

        .manager-appointment-create-form-card {
            background: var(--color-surface);
            border: 1px solid var(--color-border);
            border-radius: 18px;
            box-shadow: var(--shadow-sm);
            overflow: hidden;
        }

        .manager-appointment-create-form-header {
            padding: 20px 22px;
            display: flex;
            align-items: center;
            gap: 12px;
            border-bottom: 1px solid var(--color-border);
        }

        .manager-appointment-create-form-header-icon {
            width: 38px;
            height: 38px;
            min-width: 38px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 10px;
            background: var(--color-primary-light);
            color: var(--color-primary);
            font-size: 0.9rem;
        }

        .manager-appointment-create-form-header h2 {
            margin: 0;
            font-size: 0.95rem;
            font-weight: 700;
            color: var(--color-text);
        }

        .manager-appointment-create-form-header p {
            margin: 3px 0 0;
            font-size: 0.7rem;
            color: var(--color-muted);
        }

        .manager-appointment-create-form-body {
            padding: 22px;
        }


        /* =========================================================
                                   FORM SECTION
                                   ========================================================= */

        .manager-appointment-create-form-section {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

            .manager-appointment-create-form-section +
            .manager-appointment-create-form-section {
                margin-top: 26px;
                padding-top: 24px;
                border-top: 1px solid var(--color-border);
            }

        .manager-appointment-create-section-heading {
            display: flex;
            align-items: center;
            gap: 9px;
        }

            .manager-appointment-create-section-heading i {
                color: var(--color-primary);
                font-size: 0.82rem;
            }

            .manager-appointment-create-section-heading h3 {
                margin: 0;
                font-size: 0.82rem;
                font-weight: 700;
                color: var(--color-text);
            }


        /* =========================================================
                                   FORM GRID
                                   ========================================================= */

        .manager-appointment-create-form-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 16px;
        }

        .manager-appointment-create-form-group {
            display: flex;
            flex-direction: column;
            gap: 7px;
        }

            .manager-appointment-create-form-group.full {
                grid-column: 1 / -1;
            }

        .manager-appointment-create-label {
            font-size: 0.7rem;
            font-weight: 600;
            color: var(--color-text);
        }

            .manager-appointment-create-label span {
                color: var(--color-danger);
            }


        /* =========================================================
                                   INPUT / SELECT
                                   ========================================================= */

        .manager-appointment-create-input,
        .manager-appointment-create-select,
        .manager-appointment-create-textarea {
            width: 100%;
            border: 1px solid var(--color-border-strong);
            border-radius: 10px;
            background: var(--color-surface);
            color: var(--color-text);
            font-family: inherit;
            font-size: 0.75rem;
            outline: none;
            transition: border-color var(--transition-fast), box-shadow var(--transition-fast), background-color var(--transition-fast);
        }

        .manager-appointment-create-input,
        .manager-appointment-create-select {
            height: 42px;
            padding: 0 12px;
        }

        .manager-appointment-create-textarea {
            min-height: 105px;
            padding: 12px;
            resize: vertical;
        }

            .manager-appointment-create-input:focus,
            .manager-appointment-create-select:focus,
            .manager-appointment-create-textarea:focus {
                border-color: var(--color-primary);
                box-shadow: 0 0 0 3px rgba(108, 99, 168, 0.10);
            }

            .manager-appointment-create-input::placeholder,
            .manager-appointment-create-textarea::placeholder {
                color: var(--color-muted);
            }


        /* =========================================================
                                   CUSTOMER INFO
                                   ========================================================= */

        .manager-appointment-create-selected-user {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 13px 14px;
            border: 1px solid var(--color-border);
            border-radius: 12px;
            background: var(--color-surface-alt);
        }

        .manager-appointment-create-user-avatar {
            width: 40px;
            height: 40px;
            min-width: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: var(--color-primary-light);
            color: var(--color-primary);
            font-size: 0.85rem;
        }

        .manager-appointment-create-user-info {
            min-width: 0;
            display: flex;
            flex-direction: column;
            gap: 3px;
        }

        .manager-appointment-create-user-name {
            font-size: 0.76rem;
            font-weight: 700;
            color: var(--color-text);
        }

        .manager-appointment-create-user-email {
            font-size: 0.64rem;
            color: var(--color-muted);
        }


        /* =========================================================
                                   ANIMAL INFO
                                   ========================================================= */

        .manager-appointment-create-selected-animal {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 13px 14px;
            border: 1px solid var(--color-border);
            border-radius: 12px;
            background: var(--color-surface-alt);
        }

        .manager-appointment-create-animal-image {
            width: 48px;
            height: 48px;
            min-width: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            border-radius: 50%;
            background: var(--color-primary-light);
            color: var(--color-primary);
        }

            .manager-appointment-create-animal-image img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
            }

        .manager-appointment-create-animal-info {
            min-width: 0;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .manager-appointment-create-animal-name {
            font-size: 0.8rem;
            font-weight: 700;
            color: var(--color-text);
        }

        .manager-appointment-create-animal-meta {
            font-size: 0.65rem;
            color: var(--color-muted);
        }


        /* =========================================================
                                   SUMMARY CARD
                                   ========================================================= */

        .manager-appointment-create-summary-card {
            position: sticky;
            top: 92px;
            background: var(--color-surface);
            border: 1px solid var(--color-border);
            border-radius: 18px;
            box-shadow: var(--shadow-sm);
            overflow: hidden;
        }

        .manager-appointment-create-summary-header {
            padding: 20px;
            display: flex;
            align-items: center;
            gap: 12px;
            border-bottom: 1px solid var(--color-border);
        }

        .manager-appointment-create-summary-icon {
            width: 38px;
            height: 38px;
            min-width: 38px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 10px;
            background: var(--color-primary-light);
            color: var(--color-primary);
            font-size: 0.9rem;
        }

        .manager-appointment-create-summary-header h2 {
            margin: 0;
            font-size: 0.92rem;
            font-weight: 700;
        }

        .manager-appointment-create-summary-header p {
            margin: 3px 0 0;
            font-size: 0.66rem;
            color: var(--color-muted);
        }

        .manager-appointment-create-summary-body {
            padding: 20px;
        }


        /* =========================================================
                                   EMPTY SUMMARY
                                   ========================================================= */

        .manager-appointment-create-summary-empty {
            min-height: 270px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
        }

        .manager-appointment-create-summary-empty-icon {
            width: 64px;
            height: 64px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 16px;
            border-radius: 18px;
            background: var(--color-primary-light);
            color: var(--color-primary);
            font-size: 1.4rem;
        }

        .manager-appointment-create-summary-empty h3 {
            margin: 0;
            font-size: 0.85rem;
            font-weight: 700;
        }

        .manager-appointment-create-summary-empty p {
            max-width: 240px;
            margin: 7px 0 0;
            font-size: 0.68rem;
            line-height: 1.6;
            color: var(--color-muted);
        }


        /* =========================================================
                                   SUMMARY ACTIVE
                                   ========================================================= */

        .manager-appointment-create-summary-active {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .manager-appointment-create-summary-animal {
            display: flex;
            align-items: center;
            gap: 12px;
            padding-bottom: 16px;
            border-bottom: 1px solid var(--color-border);
        }

        .manager-appointment-create-summary-animal-image {
            width: 54px;
            height: 54px;
            min-width: 54px;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            border-radius: 14px;
            background: var(--color-primary-light);
            color: var(--color-primary);
        }

            .manager-appointment-create-summary-animal-image img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .manager-appointment-create-summary-animal-name {
            display: block;
            font-size: 0.84rem;
            font-weight: 700;
        }

        .manager-appointment-create-summary-animal-type {
            display: block;
            margin-top: 3px;
            font-size: 0.66rem;
            color: var(--color-muted);
        }


        /* =========================================================
                                   SUMMARY INFO
                                   ========================================================= */

        .manager-appointment-create-summary-list {
            display: flex;
            flex-direction: column;
            gap: 13px;
        }

        .manager-appointment-create-summary-item {
            display: flex;
            align-items: flex-start;
            gap: 10px;
        }

        .manager-appointment-create-summary-item-icon {
            width: 30px;
            height: 30px;
            min-width: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            background: var(--color-surface-alt);
            color: var(--color-primary);
            font-size: 0.72rem;
        }

        .manager-appointment-create-summary-item-content {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .manager-appointment-create-summary-item-label {
            font-size: 0.61rem;
            color: var(--color-muted);
        }

        .manager-appointment-create-summary-item-value {
            font-size: 0.72rem;
            font-weight: 600;
            color: var(--color-text);
        }


        /* =========================================================
                                   STATUS
                                   ========================================================= */

        .manager-appointment-create-summary-status {
            margin-top: 2px;
            padding-top: 16px;
            border-top: 1px solid var(--color-border);
        }

        .manager-appointment-create-summary-status-label {
            display: block;
            margin-bottom: 8px;
            font-size: 0.62rem;
            color: var(--color-muted);
        }

        .manager-appointment-create-summary-status-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 10px;
            border-radius: 999px;
            background: #eef8f1;
            color: var(--color-success);
            font-size: 0.67rem;
            font-weight: 600;
        }


        /* =========================================================
                                   FORM ACTIONS
                                   ========================================================= */

        .manager-appointment-create-actions {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 10px;
            margin-top: 24px;
            padding-top: 20px;
            border-top: 1px solid var(--color-border);
        }


        /* =========================================================
                                   RESPONSIVE
                                   ========================================================= */

        @@media (max-width: 1100px) {

            .manager-appointment-create-content {
                grid-template-columns: 1fr;
            }

            .manager-appointment-create-summary-card {
                position: static;
            }
        }


        @@media (max-width: 768px) {

            .manager-appointment-create-page {
                gap: 20px;
            }

            .manager-appointment-create-header {
                align-items: flex-start;
                flex-direction: column;
            }

                .manager-appointment-create-header .btn-ui {
                    width: 100%;
                }

            .manager-appointment-create-form-grid {
                grid-template-columns: 1fr;
            }

            .manager-appointment-create-form-group.full {
                grid-column: auto;
            }

            .manager-appointment-create-actions {
                flex-direction: column-reverse;
            }

                .manager-appointment-create-actions
                .btn-ui {
                    width: 100%;
                }
        }
    </style>

    <div class="manager-appointment-create-page">

        <div class="manager-appointment-create-header">

            <div class="manager-appointment-create-header-left">

                <div class="manager-appointment-create-header-icon">

                    <i class="fa-solid fa-calendar-plus"></i>

                </div>


                <div>

                    <h1 class="manager-appointment-create-title">
                        Yeni Randevu Oluştur
                    </h1>

                    <p class="manager-appointment-create-subtitle">
                        Hasta ve randevu bilgilerini girerek yeni bir randevu oluşturun.
                    </p>

                </div>

            </div>


            <a href="/Appointment/Index"
               class="btn-ui btn-ui--outline">

                <i class="fa-solid fa-arrow-left"></i>

                Randevulara Dön

            </a>

        </div>



        <div class="manager-appointment-create-content">

             @await Component.InvokeAsync("_ManagerAppointmentCreateFormComponentPartial")

            <aside class="manager-appointment-create-summary-card">


                <div class="manager-appointment-create-summary-header">

                    <div class="manager-appointment-create-summary-icon">

                        <i class="fa-solid fa-clipboard-check"></i>

                    </div>

                    <div>

                        <h2>
                            Randevu Özeti
                        </h2>

                        <p>
                            Seçtiğiniz bilgiler burada görüntülenir.
                        </p>

                    </div>

                </div>



                <div class="manager-appointment-create-summary-body">


                    <!-- EMPTY STATE -->

                    <div class="manager-appointment-create-summary-empty"
                         id="summaryEmpty">

                        <div class="manager-appointment-create-summary-empty-icon">

                            <i class="fa-solid fa-paw"></i>

                        </div>

                        <h3>
                            Henüz randevu bilgisi yok
                        </h3>

                        <p>
                            Randevu oluşturmak için önce müşteri ve hayvan seçimi yapın.
                        </p>

                    </div>



                    <!-- ACTIVE SUMMARY -->

                    <div class="manager-appointment-create-summary-active"
                         id="summaryActive"
                         style="display: none;">


                        <!-- ANIMAL -->

                        <div class="manager-appointment-create-summary-animal">

                            <div class="manager-appointment-create-summary-animal-image">

                                <img id="summaryAnimalImage"
                                     src=""
                                     alt="Hayvan">

                            </div>


                            <div>

                                <span class="manager-appointment-create-summary-animal-name"
                                      id="summaryAnimalName">

                                    Boncuk

                                </span>

                                <span class="manager-appointment-create-summary-animal-type"
                                      id="summaryAnimalType">

                                    Golden Retriever

                                </span>

                            </div>

                        </div>



                        <!-- INFORMATION -->

                        <div class="manager-appointment-create-summary-list">


                            <!-- OWNER -->

                            <div class="manager-appointment-create-summary-item">

                                <div class="manager-appointment-create-summary-item-icon">

                                    <i class="fa-solid fa-user"></i>

                                </div>


                                <div class="manager-appointment-create-summary-item-content">

                                    <span class="manager-appointment-create-summary-item-label">
                                        Müşteri
                                    </span>

                                    <span class="manager-appointment-create-summary-item-value"
                                          id="summaryCustomer">

                                        -

                                    </span>

                                </div>

                            </div>



                            <!-- TYPE -->

                            <div class="manager-appointment-create-summary-item">

                                <div class="manager-appointment-create-summary-item-icon">

                                    <i class="fa-solid fa-stethoscope"></i>

                                </div>


                                <div class="manager-appointment-create-summary-item-content">

                                    <span class="manager-appointment-create-summary-item-label">
                                        Randevu Türü
                                    </span>

                                    <span class="manager-appointment-create-summary-item-value"
                                          id="summaryType">

                                        -

                                    </span>

                                </div>

                            </div>



                            <!-- DATE -->

                            <div class="manager-appointment-create-summary-item">

                                <div class="manager-appointment-create-summary-item-icon">

                                    <i class="fa-solid fa-calendar-days"></i>

                                </div>


                                <div class="manager-appointment-create-summary-item-content">

                                    <span class="manager-appointment-create-summary-item-label">
                                        Tarih
                                    </span>

                                    <span class="manager-appointment-create-summary-item-value"
                                          id="summaryDate">

                                        -

                                    </span>

                                </div>

                            </div>



                            <!-- TIME -->

                            <div class="manager-appointment-create-summary-item">

                                <div class="manager-appointment-create-summary-item-icon">

                                    <i class="fa-solid fa-clock"></i>

                                </div>


                                <div class="manager-appointment-create-summary-item-content">

                                    <span class="manager-appointment-create-summary-item-label">
                                        Saat
                                    </span>

                                    <span class="manager-appointment-create-summary-item-value"
                                          id="summaryTime">

                                        -

                                    </span>

                                </div>

                            </div>

                        </div>



                        <!-- STATUS -->

                        <div class="manager-appointment-create-summary-status">

                            <span class="manager-appointment-create-summary-status-label">
                                Randevu Durumu
                            </span>


                            <span class="manager-appointment-create-summary-status-badge">

                                <i class="fa-solid fa-circle-check"></i>

                                Planlandı

                            </span>

                        </div>

                    </div>

                </div>

            </aside>


        </div>

    </div>



<script>

    // =========================================================
    // ELEMENTS
    // =========================================================

    const customerSelect =
        document.getElementById("customerSelect");

    const animalSelect =
        document.getElementById("animalSelect");

    const selectedCustomerBox =
        document.getElementById("selectedCustomerBox");

    const selectedCustomerName =
        document.getElementById("selectedCustomerName");

    const selectedCustomerEmail =
        document.getElementById("selectedCustomerEmail");

    const selectedAnimalBox =
        document.getElementById("selectedAnimalBox");

    const selectedAnimalImage =
        document.getElementById("selectedAnimalImage");

    const selectedAnimalName =
        document.getElementById("selectedAnimalName");

    const selectedAnimalMeta =
        document.getElementById("selectedAnimalMeta");


    // =========================================================
    // APPOINTMENT SUMMARY ELEMENTS
    // =========================================================

    const summaryEmpty =
        document.getElementById("summaryEmpty");

    const summaryActive =
        document.getElementById("summaryActive");

    const summaryAnimalImage =
        document.getElementById("summaryAnimalImage");

    const summaryAnimalName =
        document.getElementById("summaryAnimalName");

    const summaryAnimalType =
        document.getElementById("summaryAnimalType");

    const summaryCustomer =
        document.getElementById("summaryCustomer");

    const summaryType =
        document.getElementById("summaryType");

    const summaryDate =
        document.getElementById("summaryDate");

    const summaryTime =
        document.getElementById("summaryTime");

    const appointmentType =
        document.getElementById("appointmentType");

    const appointmentDate =
        document.getElementById("appointmentDate");

    const appointmentTime =
        document.getElementById("appointmentTime");


    // =========================================================
    // TÜM HAYVANLARI SAKLA
    // =========================================================

    const allAnimalOptions =
        Array.from(
            animalSelect.querySelectorAll(
                "option[data-owner-id]"
            )
        );


    // =========================================================
    // CUSTOMER CHANGE
    // =========================================================

    customerSelect.addEventListener(
        "change",
        function () {

            const selectedCustomerId =
                this.value;


            // -------------------------------------------------
            // CUSTOMER SEÇİLMEDİ
            // -------------------------------------------------

            if (!selectedCustomerId) {

                selectedCustomerBox.style.display =
                    "none";

                animalSelect.disabled =
                    true;

                animalSelect.innerHTML = `
                    <option value="">
                        Önce müşteri seçiniz
                    </option>
                `;

                selectedAnimalBox.style.display =
                    "none";

                updateSummary();

                return;
            }


            // -------------------------------------------------
            // SEÇİLEN CUSTOMER
            // -------------------------------------------------

            const selectedCustomerOption =
                this.options[this.selectedIndex];


            const customerName =
                selectedCustomerOption.textContent.trim();


            const customerEmail =
                selectedCustomerOption.dataset.email;


            // -------------------------------------------------
            // CUSTOMER BİLGİLERİNİ GÖSTER
            // -------------------------------------------------

            selectedCustomerName.textContent =
                customerName;

            selectedCustomerEmail.textContent =
                customerEmail || "E-posta bilgisi bulunmuyor";


            selectedCustomerBox.style.display =
                "block";


            // -------------------------------------------------
            // HAYVANLARI FİLTRELE
            // -------------------------------------------------

            filterAnimals(selectedCustomerId);

        }
    );


    // =========================================================
    // FILTER ANIMALS
    // =========================================================

    function filterAnimals(customerId) {

        animalSelect.innerHTML = `
            <option value="">
                Hayvan seçiniz
            </option>
        `;


        let animalCount = 0;


        allAnimalOptions.forEach(
            function (originalOption) {

                const ownerId =
                    originalOption.dataset.ownerId;


                if (ownerId === customerId) {

                    const option =
                        originalOption.cloneNode(true);

                    animalSelect.appendChild(option);

                    animalCount++;

                }

            }
        );


        // -----------------------------------------------------
        // HAYVAN YOK
        // -----------------------------------------------------

        if (animalCount === 0) {

            animalSelect.innerHTML = `
                <option value="">
                    Bu müşteriye ait hayvan bulunamadı
                </option>
            `;

            animalSelect.disabled =
                true;

            selectedAnimalBox.style.display =
                "none";

            updateSummary();

            return;
        }


        // -----------------------------------------------------
        // HAYVAN VAR
        // -----------------------------------------------------

        animalSelect.disabled =
            false;

    }


    // =========================================================
    // ANIMAL CHANGE
    // =========================================================

    animalSelect.addEventListener(
        "change",
        function () {

            const selectedOption =
                this.options[this.selectedIndex];


            if (!this.value) {

                selectedAnimalBox.style.display =
                    "none";

                updateSummary();

                return;
            }


            const animalName =
                selectedOption.dataset.name;

            const species =
                selectedOption.dataset.species;

            const breed =
                selectedOption.dataset.breed;

            const age =
                selectedOption.dataset.age;

            const weight =
                selectedOption.dataset.weight;

            const image =
                selectedOption.dataset.image;


            // -------------------------------------------------
            // HAYVAN BİLGİLERİ
            // -------------------------------------------------

            selectedAnimalName.textContent =
                animalName;


            selectedAnimalMeta.textContent =
                `${species} · ${breed} · ${age} yaş · ${weight} kg`;


            // -------------------------------------------------
            // HAYVAN RESMİ
            // -------------------------------------------------

            if (image) {

                selectedAnimalImage.src =
                    image;

                selectedAnimalImage.style.display =
                    "block";

            }
            else {

                selectedAnimalImage.src =
                    "";

            }


            selectedAnimalImage.alt =
                animalName;


            selectedAnimalBox.style.display =
                "block";


            updateSummary();

        }
    );


    // =========================================================
    // SUMMARY
    // =========================================================

    function updateSummary() {

        if (
            !summaryEmpty ||
            !summaryActive
        ) {
            return;
        }


        const selectedCustomerOption =
            customerSelect.options[
                customerSelect.selectedIndex
            ];


        const selectedAnimalOption =
            animalSelect.options[
                animalSelect.selectedIndex
            ];


        if (
            !customerSelect.value ||
            !animalSelect.value ||
            !selectedAnimalOption
        ) {

            summaryEmpty.style.display =
                "flex";

            summaryActive.style.display =
                "none";

            return;
        }


        summaryEmpty.style.display =
            "none";

        summaryActive.style.display =
            "flex";


        // -----------------------------------------------------
        // CUSTOMER
        // -----------------------------------------------------

        summaryCustomer.textContent =
            selectedCustomerOption.textContent.trim();


        // -----------------------------------------------------
        // ANIMAL
        // -----------------------------------------------------

        const animalName =
            selectedAnimalOption.dataset.name;

        const species =
            selectedAnimalOption.dataset.species;

        const breed =
            selectedAnimalOption.dataset.breed;

        const image =
            selectedAnimalOption.dataset.image;


        summaryAnimalName.textContent =
            animalName;


        summaryAnimalType.textContent =
            `${species} · ${breed}`;


        if (image) {

            summaryAnimalImage.src =
                image;

        }


        summaryAnimalImage.alt =
            animalName;


        // -----------------------------------------------------
        // APPOINTMENT TYPE
        // -----------------------------------------------------

        summaryType.textContent =
            appointmentType?.value || "-";


        // -----------------------------------------------------
        // DATE
        // -----------------------------------------------------

        if (appointmentDate?.value) {

            summaryDate.textContent =
                new Date(
                    appointmentDate.value + "T00:00:00"
                ).toLocaleDateString(
                    "tr-TR",
                    {
                        day: "2-digit",
                        month: "long",
                        year: "numeric"
                    }
                );

        }
        else {

            summaryDate.textContent =
                "-";

        }


        // -----------------------------------------------------
        // TIME
        // -----------------------------------------------------

        summaryTime.textContent =
            appointmentTime?.value || "-";

    }


    // =========================================================
    // APPOINTMENT INPUT CHANGES
    // =========================================================

    if (appointmentType) {

        appointmentType.addEventListener(
            "change",
            updateSummary
        );

    }


    if (appointmentDate) {

        appointmentDate.addEventListener(
            "change",
            updateSummary
        );

    }


    if (appointmentTime) {

        appointmentTime.addEventListener(
            "change",
            updateSummary
        );

    }

</script>
}
