            

<section class="appointment-stats" aria-label="Randevu özeti">
    <div class="appointment-stat-card is-primary">
        <div class="appointment-stat-icon"><i class="bi bi-calendar2-week"></i></div>
        <div>
            <div class="appointment-stat-value" id="statTotal">@ViewBag.TotalAppointment</div>
            <div class="appointment-stat-label">Toplam Randevu</div>
        </div>
    </div>
    <div class="appointment-stat-card is-info">
        <div class="appointment-stat-icon"><i class="bi bi-clock-history"></i></div>
        <div>
            <div class="appointment-stat-value" id="statUpcoming">@ViewBag.UpcomingAppointments</div>
            <div class="appointment-stat-label">Yaklaşan Randevu</div>
        </div>
    </div>
    <div class="appointment-stat-card is-success">
        <div class="appointment-stat-icon"><i class="bi bi-check-circle"></i></div>
        <div>
            <div class="appointment-stat-value" id="statCompleted">@ViewBag.CompletedAppointments</div>
            <div class="appointment-stat-label">Tamamlanan Randevu</div>
        </div>
    </div>
    <div class="appointment-stat-card is-danger">
        <div class="appointment-stat-icon"><i class="bi bi-x-circle"></i></div>
        <div>
            <div class="appointment-stat-value" id="statCancelled">@ViewBag.CancelledAppointments</div>
            <div class="appointment-stat-label">İptal Edilen Randevu</div>
        </div>
    </div>
</section>
