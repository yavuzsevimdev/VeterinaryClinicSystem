<section class="animal-stats">

    <div class="animal-stat-card">

        <div class="animal-stat-icon primary">

            <i class="fa-solid fa-paw"></i>

        </div>

        <div>

            <p class="animal-stat-label">
                Toplam Hayvan
            </p>

            <p class="animal-stat-value">
                @ViewBag.TotalAnimalCount
            </p>

            <p class="animal-stat-description">
                Klinik kayıtları
            </p>

        </div>

    </div>


    <div class="animal-stat-card">

        <div class="animal-stat-icon green">

            <i class="fa-solid fa-dog"></i>

        </div>

        <div>

            <p class="animal-stat-label">
                Köpek
            </p>

            <p class="animal-stat-value">
                @ViewBag.TotalDogCount
            </p>

            <p class="animal-stat-description">
                Kayıtlı köpekler
            </p>

        </div>

    </div>


    <div class="animal-stat-card">

        <div class="animal-stat-icon blue">

            <i class="fa-solid fa-cat"></i>

        </div>

        <div>

            <p class="animal-stat-label">
                Kedi
            </p>

            <p class="animal-stat-value">
                @ViewBag.TotalCatCount
            </p>

            <p class="animal-stat-description">
                Kayıtlı kediler
            </p>

        </div>

    </div>


    <div class="animal-stat-card">

        <div class="animal-stat-icon orange">

            <i class="fa-solid fa-shield-dog"></i>

        </div>

        <div>

            <p class="animal-stat-label">
                Diğer
            </p>

            <p class="animal-stat-value">
                @ViewBag.TotalOtherCount
            </p>

            <p class="animal-stat-description">
                Diğer türler
            </p>

        </div>

    </div>

</section>