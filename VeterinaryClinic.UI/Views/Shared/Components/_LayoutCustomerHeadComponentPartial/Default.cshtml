<title>VetCare OS — Dashboard</title>

<!-- Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.0/css/all.min.css">
<!-- Bootstrap -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

<!-- VetCare UI Foundation -->
<link rel="stylesheet" href="~/vetcare-ui-foundation/css/main.css" />

<style>
    .animal-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding: 0;
}

.animal-card-media {
    position: relative;
    height: 168px;
    background: linear-gradient(135deg, var(--color-secondary-light) 0%, var(--color-primary-light) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

    .animal-card-media img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        position: absolute;
        inset: 0;
        transition: transform var(--transition-slow);
    }

.animal-card:hover .animal-card-media img {
    transform: scale(1.05);
}

.animal-card-media-fallback-icon {
    position: relative;
    z-index: 0;
    font-size: 2.25rem;
    color: var(--color-primary);
    opacity: 0.55;
}

.animal-card-media-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(48,48,68,0) 45%, rgba(48,48,68,0.55) 100%);
    z-index: 1;
}

.animal-card-species-badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 2;
    background-color: rgba(255,255,255,0.92);
    color: var(--color-text);
    font-size: 0.7rem;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    display: flex;
    align-items: center;
    gap: 4px;
}

.animal-card-name-overlay {
    position: absolute;
    left: 0.9rem;
    bottom: 0.75rem;
    z-index: 2;
    color: #fff;
    font-size: 1.1rem;
    font-weight: 700;
    text-shadow: 0 1px 6px rgba(0,0,0,0.25);
}

.animal-card-breed-overlay {
    position: absolute;
    left: 0.9rem;
    bottom: 0.3rem;
    z-index: 2;
    color: rgba(255,255,255,0.85);
    font-size: 0.75rem;
    font-weight: 500;
    text-shadow: 0 1px 6px rgba(0,0,0,0.25);
}

.animal-card-body {
    padding: 1.1rem 1.25rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex: 1 1 auto;
}

.animal-card-metrics {
    display: flex;
    gap: 1rem;
}

.animal-card-metric {
    flex: 1 1 0;
    text-align: center;
    padding: 0.5rem 0.25rem;
    background-color: var(--color-surface-alt);
    border-radius: var(--radius-sm);
}

.animal-card-metric-value {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-text);
}

.animal-card-metric-label {
    font-size: 0.65rem;
    color: var(--color-muted-light);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
}

.animal-card-history {
    font-size: 0.78125rem;
    color: var(--color-muted);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.animal-card-footer {
    margin-top: auto;
    display: flex;
    justify-content: flex-end;
}

.animal-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
}

@@media (max-width: 1200px) {
    .animal-grid {
        grid-template-columns: repeat(3, 1fr);
    }
}

@@media (max-width: 768px) {
    .animal-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@@media (max-width: 576px) {
    .animal-grid {
        grid-template-columns: 1fr;
    }
}
</style>