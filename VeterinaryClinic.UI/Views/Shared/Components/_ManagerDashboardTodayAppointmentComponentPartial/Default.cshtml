@model List<ManagerDashboardAppointmentDto>

<section class="dashboard-appointments card-ui" id="dashboard-appointments" aria-label="Today's appointments">
    <div class="card-header-row">
        <div>
            <h2 class="text-card-title">Bugüne Ait Randevular</h2>
            <span class="text-tiny text-muted">@DateTime.Today.ToString("dddd, M MMMM, yyyy") </span>
        </div>
        <a href="#" class="link-action">View All <i class="bi bi-arrow-right"></i></a>
    </div>

    <div>
        @foreach (var item in Model)
        {
            <div class="appointment-row">
                <div class="appointment-time">@item.Time.ToString(@"hh\:mm")</div>
                <span class="appointment-time-sep"></span>
                <div class="appointment-body">
                    <span class="appointment-animal">@item.AnimalName <span class="appointment-animal-id">#@item.AnimalId</span></span>
                    <div class="appointment-notes">@item.Notes</div>
                </div>
                <div class="appointment-meta">
                    <span class="badge-ui @(item.Status == "Scheduled" ? "badge-ui--info" 
                                          : item.Status == "Completed" ? "badge-ui--success" 
                                          : "badge-ui--danger")">
                    @item.Status
                    </span>
                    <button class="appointment-action-btn" aria-label="Randevu Detaylarını Görüntüle" data-toast-action="Randevuyu Görüntüle">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
            </div>

        }
    </div>
</section>
