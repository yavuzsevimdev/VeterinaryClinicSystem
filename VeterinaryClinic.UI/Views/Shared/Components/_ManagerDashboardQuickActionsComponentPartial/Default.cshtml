<section class="dashboard-quick-actions" id="dashboard-quick-actions" aria-label="Hızlı İşlemler">
    <div class="section-header" style="margin-bottom: 1.25rem;">
        <div>
            <h2 class="text-section-title">Hızlı İşlemler</h2>
            <p class="section-header-desc">Sık kullanılan yönetim işlemleri</p>
        </div>
    </div>

    <div class="grid-auto-fit">
        <button type="button" class="card-ui card-ui--interactive quick-action-tile" data-toast-action="Yeni Hayvan">
            <div class="card-icon-tile is-primary"><i class="bi bi-plus-circle"></i></div>
            <span class="quick-action-title">Yeni Hayvan</span>
            <span class="quick-action-desc">Yeni hasta kaydı yapın</span>
        </button>
        <button type="button" class="card-ui card-ui--interactive quick-action-tile" data-toast-action="Yeni Randevu">
            <div class="card-icon-tile is-info"><i class="bi bi-calendar-plus"></i></div>
            <span class="quick-action-title">Yeni Randevu</span>
            <span class="quick-action-desc">Klinik randevusu alın</span>
        </button>
        <button type="button" class="card-ui card-ui--interactive quick-action-tile" data-toast-action="Yeni Tedavi">
            <div class="card-icon-tile is-accent"><i class="bi bi-capsule"></i></div>
            <span class="quick-action-title">Yeni Tedavi</span>
            <span class="quick-action-desc">Tedavi kaydı girin</span>
        </button>
        <button type="button" class="card-ui card-ui--interactive quick-action-tile" data-toast-action="Ödeme Ekle">
            <div class="card-icon-tile is-success"><i class="bi bi-credit-card-2-back"></i></div>
            <span class="quick-action-title">Ödeme Ekle</span>
            <span class="quick-action-desc">Alınan bir ödemeyi kaydet</span>
        </button>
        <button type="button" class="card-ui card-ui--interactive quick-action-tile" data-toast-action="Raporları Görüntüle">
            <div class="card-icon-tile is-warning"><i class="bi bi-file-earmark-bar-graph"></i></div>
            <span class="quick-action-title">Raporları Görüntüle</span>
            <span class="quick-action-desc">Rapor merkezini açın</span>
        </button>
    </div>
</section>