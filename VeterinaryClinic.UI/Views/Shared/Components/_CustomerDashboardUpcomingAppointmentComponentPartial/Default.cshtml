@model UpcomingAppointmentDto
<style>
    .upcoming-empty-state {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: var(--space-4);
    padding: 16px;
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-md);
    background-color: var(--color-surface-alt);
}

.upcoming-empty-icon {
    width: 48px;
    height: 48px;
    min-width: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background-color: var(--color-primary-light);
    color: var(--color-primary);
    font-size: 1.2rem;
}

.upcoming-empty-content {
    min-width: 0;
}

.upcoming-empty-content h4 {
    margin: 0 0 4px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-text);
}

.upcoming-empty-content p {
    margin: 0 0 12px;
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--color-muted);
}
</style>
<div class="card-ui card-ui--status is-info">

    @if(Model != null)
    {
        <div class="card-header-row">

        <div>

            <h3 class="text-card-title">
                Yaklaşan Randevu
            </h3>

            <span class="text-tiny text-muted">
                Bir sonraki planlanan ziyaret
            </span>

        </div>


        <span class="badge-ui badge-ui--info">
            Planlanan
        </span>

    </div>


    <div class="stack"
         style="gap:10px; margin-top:var(--space-4);">


        <div class="row-start">

            <i class="bi bi-heart-pulse text-muted"></i>

            <span class="text-small">
                @Model.AnimalName
            </span>

        </div>


        <div class="row-start">

            <i class="bi bi-calendar3 text-muted"></i>

            <span class="text-small">
                @Model.Date.ToString("dd MMM yyyy") · @Model.Time.ToString(@"hh\:mm")
            </span>

        </div>


        <div class="row-start">

            <i class="bi bi-clipboard2-pulse text-muted"></i>

            <span class="text-small">
                @Model.Notes
            </span>

        </div>

    </div>


    <div style="margin-top:var(--space-4);">

        <a href="/Appointment/Detail/@Model.AppointmentId"
                class="btn btn-ui btn-ui--outline btn-ui--sm">

            Randevuyu Görüntüle

            <i class="bi bi-arrow-right"></i>

        </a>

    </div>
    }
    @if (Model == null)
{
    <div class="upcoming-empty-state">

        <div class="upcoming-empty-icon">
            <i class="bi bi-calendar-heart"></i>
        </div>

        <div class="upcoming-empty-content">

            <h4>
                Yaklaşan randevunuz bulunmuyor
            </h4>

            <p>
                Şu anda planlanmış bir randevunuz bulunmuyor.
                Yeni bir randevu oluşturarak kliniğimizi ziyaret edebilirsiniz.
            </p>

            <a href="/Appointment/Create"
               class="btn btn-ui btn-ui--outline btn-ui--sm">

                <i class="bi bi-plus-lg"></i>

                Randevu Oluştur

            </a>

        </div>

    </div>
}

</div>
