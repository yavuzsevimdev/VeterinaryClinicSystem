<section class="section-header" aria-label="Sayfa başlığı">
    <div class="section-header-text">
        <h1 class="text-page-title">Hayvanlarım</h1>
        <p class="section-header-desc">Kayıtlı evcil hayvanlarınızı yönetin ve sağlık geçmişlerine kolayca ulaşın.</p>

        <span class="animal-header-count text-small text-muted">
            <i class="bi bi-clipboard2-pulse"></i>
            <span><strong id="animalCount">@ViewBag.animalCount</strong> kayıtlı hayvan</span>
        </span>
    </div>
    <div class="section-header-actions">
        <button type="button" class="btn-ui btn-ui--primary" id="addAnimalBtn">
            <a href="/animal/create">
                <i class="bi bi-plus-lg"></i> Hayvan Ekle
            </a>
        </button>
    </div>
</section>
