    /* Toast (used for prototype-only action feedback) */
    .toast-stack {
        position: fixed;
        top: 1.5rem;
        right: 1.5rem;
        z-index: var(--z-toast);
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        width: min(360px, calc(100vw - 3rem));
    }

    .toast-ui {
        background-color: var(--color-surface);
        border-radius: var(--radius-md);
        box-shadow: var(--shadow-lg);
        border: 1px solid var(--color-border);
        padding: 1rem;
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        animation: toast-in var(--transition-slow);
        position: relative;
        overflow: hidden;
    }

        .toast-ui.is-leaving {
            animation: toast-out var(--transition-base) forwards;
        }

        .toast-ui::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 4px;
            background-color: var(--color-info);
        }

        .toast-ui.is-success::before {
            background-color: var(--color-success);
        }

    .toast-ui-icon {
        font-size: 1.1rem;
        color: var(--color-success);
    }

    .toast-ui-body {
        flex: 1 1 auto;
    }

    .toast-ui-title {
        font-weight: 600;
        font-size: 0.85rem;
        margin-bottom: 2px;
    }

    .toast-ui-message {
        font-size: 0.8125rem;
        color: var(--color-muted);
    }

    .toast-ui-close {
        color: var(--color-muted-light);
        font-size: 0.9rem;
    }

    @@keyframes toast-in {
        from {
            opacity: 0;
            transform: translateX(24px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }
    @@keyframes toast-out {
        from {
            opacity: 1;
            transform: translateX(0);
        }

        to {
            opacity: 0;
            transform: translateX(24px);
        }
    }

