<div class="manager-report-card manager-report-card--monthly">

    <div class="manager-report-card-header">

        <div class="manager-report-card-heading">

            <div class="manager-report-card-icon">
                <i class="fa-solid fa-chart-column"></i>
            </div>

            <div>

                <h2>
                    Aylık Rapor
                </h2>

                <p>
                    Aylık randevu, tedavi ve tahsilat verilerini görüntüleyin.
                </p>

            </div>

        </div>


        <div class="manager-report-date-badge">

            <i class="fa-regular fa-calendar"></i>

            @DateTime.Today.Date.ToString("MMMM yyyy")

        </div>

    </div>

    <div class="manager-report-stat-grid manager-report-stat-grid--four">

        <div class="manager-report-stat">

            <div class="manager-report-stat-icon">
                <i class="fa-solid fa-calendar-check"></i>
            </div>

            <div>

                <span class="manager-report-stat-label">
                    Randevu
                </span>

                <strong>
                    @ViewBag.MontlyhApppointmentCount
                </strong>

            </div>

        </div>


        <div class="manager-report-stat">

            <div class="manager-report-stat-icon">
                <i class="fa-solid fa-stethoscope"></i>
            </div>

            <div>

                <span class="manager-report-stat-label">
                    Tedavi
                </span>

                <strong>
                    @ViewBag.MonthlyTreatmentCount
                </strong>

            </div>

        </div>


        <div class="manager-report-stat">

            <div class="manager-report-stat-icon">
                <i class="fa-solid fa-users"></i>
            </div>

            <div>

                <span class="manager-report-stat-label">
                    Hasta
                </span>

                <strong>
                    @ViewBag.TotalAnimals
                </strong>

            </div>

        </div>


        <div class="manager-report-stat">

            <div class="manager-report-stat-icon manager-report-stat-icon--success">
                <i class="fa-solid fa-coins"></i>
            </div>

            <div>

                <span class="manager-report-stat-label">
                    Toplam Tahsilat
                </span>

                <strong class="manager-report-stat-value--success">
                    @ViewBag.TotalAmountPaid.ToString("0,0") ₺
                </strong>

            </div>

        </div>

    </div>

    <div class="manager-report-content">

        <span class="manager-report-content-title">
            Rapor İçeriği
        </span>

        <div class="manager-report-check-grid">

            <span>
                <i class="fa-solid fa-circle-check"></i>
                Aylık randevu istatistikleri
            </span>

            <span>
                <i class="fa-solid fa-circle-check"></i>
                Tahsilat ve ödeme analizi
            </span>

            <span>
                <i class="fa-solid fa-circle-check"></i>
                Tedavi dağılımı
            </span>

            <span>
                <i class="fa-solid fa-circle-check"></i>
                Gün bazlı grafikler
            </span>

        </div>

    </div>

    <div class="manager-report-actions">

        <a href="/Report/DownloadMonthlyReportPdf"
           class="manager-report-action manager-report-action--monthly">

            <i class="fa-solid fa-file-pdf"></i>

            PDF İndir

        </a>

        <button type="button"
                class="manager-report-action manager-report-action--outline-monthly"
                onclick="window.print()">

            <i class="fa-solid fa-print"></i>

            Yazdır

        </button>

        <form asp-controller="Report"
              asp-action="SendMonthlyReportPdf"
              method="post"
              style="display:inline;">

            <button type="submit"
                    class="manager-report-action manager-report-action--soft-monthly">

                <i class="fa-solid fa-envelope"></i>

                Email Gönder

            </button>

        </form>

    </div>

</div>
