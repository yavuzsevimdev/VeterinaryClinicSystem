<section class="animal-toolbar" aria-label="Arama ve filtreleme">
    <div class="input-icon-wrap animal-toolbar-search">
        <i class="bi bi-search input-icon-wrap-icon" aria-hidden="true"></i>
        <input type="search" id="animalSearchInput" class="form-control-ui" placeholder="Hayvan ara..." aria-label="Hayvan ara">
    </div>
    <div class="animal-toolbar-selects">
        <select id="animalSpeciesFilter" class="form-control-ui" aria-label="Türe göre filtrele">
            <option value="all">Tür: Tümü</option>
            <option value="kopek">Köpek</option>
            <option value="kedi">Kedi</option>
            <option value="kus">Kuş</option>
            <option value="diger">Diğer</option>
        </select>
        <select id="animalSortSelect" class="form-control-ui" aria-label="Sırala">
            <option value="az">A-Z</option>
            <option value="new">Yeni eklenenler</option>
            <option value="age">Yaşa göre</option>
        </select>
    </div>
</section>
