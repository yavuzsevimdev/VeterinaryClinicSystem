<div class="manager-report-card manager-report-card--daily">

    <div class="manager-report-card-header">

        <div class="manager-report-card-heading">

            <div class="manager-report-card-icon">
                <i class="fa-solid fa-calendar-days"></i>
            </div>

            <div>

                <h2>
                    Günlük Rapor
                </h2>

                <p>
                    Bugünkü randevu, tedavi ve ödeme bilgilerini görüntüleyin.
                </p>

            </div>

        </div>


        <div class="manager-report-date-badge">

            <i class="fa-regular fa-calendar"></i>

            @DateTime.Today.Date.ToString("dd MMM yyyy")

        </div>

    </div>

    <div class="manager-report-stat-grid manager-report-stat-grid--four">

        <div class="manager-report-stat">

            <div class="manager-report-stat-icon">
                <i class="fa-solid fa-calendar-check"></i>
            </div>

            <div>

                <span class="manager-report-stat-label">
                    Randevu
                </span>

                <strong>
                    @ViewBag.TodayApppointmentCount
                </strong>

            </div>

        </div>


        <div class="manager-report-stat">

            <div class="manager-report-stat-icon">
                <i class="fa-solid fa-stethoscope"></i>
            </div>

            <div>

                <span class="manager-report-stat-label">
                    Tamamlanan
                </span>

                <strong>
                    @ViewBag.CompletedApppointmentCount
                </strong>

            </div>

        </div>


        <div class="manager-report-stat">

            <div class="manager-report-stat-icon">
                <i class="fa-regular fa-clock"></i>
            </div>

            <div>

                <span class="manager-report-stat-label">
                    Bekleyen
                </span>

                <strong>
                    @ViewBag.ScheduledApppointmentCount
                </strong>

            </div>

        </div>


        <div class="manager-report-stat">

            <div class="manager-report-stat-icon manager-report-stat-icon--success">
                <i class="fa-solid fa-coins"></i>
            </div>

            <div>

                <span class="manager-report-stat-label">
                    Toplam Tahsilat
                </span>

                <strong class="manager-report-stat-value--success">
                    @ViewBag.TotalAmountPaid.ToString("0,0") ₺
                </strong>

            </div>

        </div>

    </div>

    <div class="manager-report-content">

        <span class="manager-report-content-title">
            Rapor İçeriği
        </span>

        <div class="manager-report-check-grid">

            <span>
                <i class="fa-solid fa-circle-check"></i>
                Günün tüm randevuları
            </span>

            <span>
                <i class="fa-solid fa-circle-check"></i>
                Yapılan ödemeler
            </span>

            <span>
                <i class="fa-solid fa-circle-check"></i>
                Gerçekleştirilen tedaviler
            </span>

            <span>
                <i class="fa-solid fa-circle-check"></i>
                Hasta bazlı detaylar
            </span>

        </div>

    </div>

    <div class="manager-report-actions">

        <a href="/Report/DownloadDailyReportPdf"
           class="manager-report-action manager-report-action--primary">

            <i class="fa-solid fa-file-pdf"></i>

            PDF İndir

        </a>

        <button type="button"
                class="manager-report-action manager-report-action--outline"
                onclick="window.print()">

            <i class="fa-solid fa-print"></i>

            Yazdır

        </button>

        <form asp-controller="Report"
              asp-action="SendDailyReportPdf"
              method="post"
              style="display:inline;">

            <button type="submit"
                    class="manager-report-action manager-report-action--soft">

                <i class="fa-solid fa-envelope"></i>

                Email Gönder

            </button>

        </form>

    </div>

</div>
