                             ========================================================================== */

            .animal-photo-url-card {
                display: flex;
                align-items: center;
                gap: 1rem;
                min-width: 0;
                width: 100%;
                overflow: hidden;
            }

            .animal-photo-url-text {
                display: block;
                width: 100%;
                max-width: 100%;
                min-width: 0;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
                font-size: 0.8125rem;
                color: var(--color-muted);
            }

            /* ==========================================================================
                             ACTION CARDS
                             ========================================================================== */

            .animal-action-grid {
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                gap: 1.25rem;
            }

            .animal-action-card {
                display: flex;
                align-items: center;
                gap: 1rem;
                text-align: left;
                width: 100%;
            }

            .animal-action-body {
                flex: 1 1 auto;
                min-width: 0;
                text-align: left;
            }

            .animal-action-title {
                font-size: 0.9375rem;
                font-weight: 600;
            }

            .animal-action-subtitle {
                font-size: 0.78125rem;
                color: var(--color-muted);
                margin-top: 2px;
            }

            .animal-action-arrow {
                flex: 0 0 auto;
                width: 36px;
                height: 36px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1rem;
                background-color: var(--color-surface-alt);
                color: var(--color-muted);
                transition: background-color var(--transition-fast), color var(--transition-fast), transform var(--transition-fast);
            }

            .animal-action-card:hover .animal-action-arrow {
                transform: translateX(3px);
            }

            .animal-action-card.is-appointment:hover .animal-action-arrow {
                background-color: var(--color-info-light);
                color: var(--color-info);
            }

            .animal-action-card.is-treatment:hover .animal-action-arrow {
                background-color: var(--color-secondary-light);
                color: #3f7d64;
            }

            .animal-action-card.is-payment:hover .animal-action-arrow {
                background-color: var(--color-primary-light);
                color: var(--color-primary);
            }

            /* ==========================================================================
                             APPOINTMENTS + NOTES
                             ========================================================================== */

            .animal-detail-columns {
                display: grid;
                grid-template-columns: 3fr 2fr;
                gap: 1.5rem;
                align-items: start;
            }

            .animal-appointment-item {
                display: flex;
                align-items: center;
                gap: 0.9rem;
                padding: 0.85rem 0;
                border-bottom: 1px solid var(--color-border);
            }

                .animal-appointment-item:last-child {
                    border-bottom: none;
                    padding-bottom: 0;
                }

                .animal-appointment-item:first-child {
                    padding-top: 0;
                }

            .animal-appointment-date {
                flex: 0 0 auto;
                width: 56px;
                text-align: center;
            }

            .animal-appointment-date-day {
                display: block;
                font-size: 1.1rem;
                font-weight: 700;
                color: var(--color-text);
                line-height: 1;
            }

            .animal-appointment-date-month {
                display: block;
                font-size: 0.65rem;
                font-weight: 600;
                color: var(--color-muted-light);
                text-transform: uppercase;
                letter-spacing: 0.03em;
                margin-top: 2px;
            }

            .animal-appointment-sep {
                flex: 0 0 auto;
                width: 1px;
                height: 34px;
                background-color: var(--color-border);
            }

            .animal-appointment-body {
                flex: 1 1 auto;
                min-width: 0;
            }

            .animal-appointment-title {
                font-size: 0.875rem;
                font-weight: 600;
                color: var(--color-text);
            }

            .animal-appointment-time {
                font-size: 0.75rem;
                color: var(--color-muted-light);
                margin-top: 2px;
            }

            .animal-notes-box {
                padding: 1rem 1.1rem;
                border-radius: var(--radius-md);
                background-color: var(--color-surface-alt);
                border: 1px solid var(--color-border);
                font-size: 0.85rem;
                color: var(--color-text);
                line-height: 1.6;
            }

            .animal-notes-edit-btn {
                flex: 0 0 auto;
                width: 32px;
                height: 32px;
                border-radius: var(--radius-sm);
                display: flex;
                align-items: center;
                justify-content: center;
                color: var(--color-muted);
                font-size: 0.9rem;
                transition: background-color var(--transition-fast), color var(--transition-fast);
            }

                .animal-notes-edit-btn:hover {
                    background-color: var(--color-primary-light);
                    color: var(--color-primary-dark);
                }

            /* ---- Toast (self-contained demo feedback) ---- */

            .animal-toast-stack {
                position: fixed;
                top: 1.5rem;
                right: 1.5rem;
                z-index: 999;
                display: flex;
                flex-direction: column;
                gap: 0.75rem;
                width: min(340px, calc(100vw - 3rem));
            }

            .animal-toast {
                background-color: var(--color-surface);
                border-radius: var(--radius-md);
                box-shadow: var(--shadow-lg);
                border: 1px solid var(--color-border);
                padding: 0.9rem 1rem;
                display: flex;
                align-items: flex-start;
                gap: 0.65rem;
                position: relative;
                overflow: hidden;
                animation: animal-toast-in var(--transition-slow);
            }

                .animal-toast.is-leaving {
                    animation: animal-toast-out var(--transition-base) forwards;
                }

                .animal-toast::before {
                    content: "";
                    position: absolute;
                    left: 0;
                    top: 0;
                    bottom: 0;
                    width: 4px;
                    background-color: var(--color-primary);
                }

            .animal-toast-icon {
                color: var(--color-primary);
                font-size: 1.05rem;
            }

            .animal-toast-message {
                font-size: 0.8125rem;
                color: var(--color-text);
            }

            @@keyframes animal-toast-in {
                from {
                    opacity: 0;
                    transform: translateX(20px);
                }

                to {
                    opacity: 1;
                    transform: translateX(0);
                }
            }

            @@keyframes animal-toast-out {
                from {
                    opacity: 1;
                    transform: translateX(0);
                }

                to {
                    opacity: 0;
                    transform: translateX(20px);
                }
            }

            /* ==========================================================================
                             RESPONSIVE
                             ========================================================================== */

            @@media (max-width: 1199.98px) {
                .app-content {
                    padding: 1.75rem;
                }
            }

            @@media (max-width: 991.98px) {
                .animal-profile-grid {
                    grid-template-columns: 1fr;
                }

                .animal-profile-media {
                    min-height: 300px;
                }

                .animal-detail-columns {
                    grid-template-columns: 1fr;
                }

                .animal-action-grid {
                    grid-template-columns: 1fr 1fr;
                }
            }

            @@media (max-width: 767.98px) {
                .app-content {
                    padding: 1.25rem;
                }

                .animal-info-grid {
                    grid-template-columns: repeat(2, 1fr);
                }

                .animal-action-grid {
                    grid-template-columns: 1fr;
                }

                .grid-2 {
                    grid-template-columns: 1fr;
                }

                .animal-detail-topbar {
                    flex-direction: column;
                    align-items: flex-start;
                }
            }

            @@media (max-width: 419.98px) {
                .animal-info-grid {
                    grid-template-columns: 1fr;
                }

                .animal-photo-url-card {
                    flex-wrap: wrap;
                }
            }

    </style>


    <main class="app-content">
        <div class="app-content-inner">

            <div class="animal-detail-topbar">
                <nav class="breadcrumb-ui" aria-label="Breadcrumb">
                    <span class="breadcrumb-ui-item"><a href="/home/dashboard">Home</a></span>
                    <span class="breadcrumb-ui-sep"><i class="bi bi-chevron-right"></i></span>
                    <span class="breadcrumb-ui-item"><a href="/animal/index">Hayvanlarım</a></span>
                    <span class="breadcrumb-ui-sep"><i class="bi bi-chevron-right"></i></span>
                    <span class="breadcrumb-ui-item is-current">Pamuk</span>
                </nav>
                <a href="/animal/index" class="btn-ui btn-ui--ghost btn-ui--sm" id="backToListBtn">
                    <i class="bi bi-arrow-left"></i> Listeye Dön
                </a>
            </div>

            <div class="animal-profile-grid">

                <div class="card-ui animal-profile-image-card">
                    <div class="animal-profile-media" id="profileMedia">
                        <div class="animal-profile-media-fallback" id="profileMediaFallback">
                            <i class="bi bi-heart-pulse"></i>
                            <span>Fotoğraf mevcut değil</span>
                        </div>
                        <img id="profileImage" alt="@Model.Name" src="@Model.ImageUrl">
                        <div class="animal-profile-media-overlay"></div>
                        <span class="animal-profile-species-badge">@Model.Species</span>
                        <button type="button" class="animal-profile-favorite-btn" id="favoriteBtn" aria-pressed="false" aria-label="Favorilere ekle">
                            <i class="bi bi-heart"></i>
                            <i class="bi bi-heart-fill"></i>
                        </button>
                        <span class="animal-profile-caption"><i class="bi bi-geo-alt-fill"></i> @Model.City </span>
                    </div>
                </div>

                <div class="card-ui animal-profile-info-card">
                    <div>
                        <h1 class="animal-profile-name">@Model.Name </h1>
                        <p class="animal-profile-desc">Evimizin neşesi.</p>
                    </div>

                    <div class="animal-info-grid">
                        <div class="animal-info-item">
                            <div class="animal-info-icon is-secondary"><i class="bi bi-clipboard2-pulse"></i></div>
                            <div class="animal-info-text">
                                <span class="animal-info-label">Tür</span>
                                <span class="animal-info-value">@Model.Species</span>
                            </div>
                        </div>
                        <div class="animal-info-item">
                            <div class="animal-info-icon is-accent"><i class="bi bi-award"></i></div>
                            <div class="animal-info-text">
                                <span class="animal-info-label">Irk</span>
                                <span class="animal-info-value">@Model.Breed</span>
                            </div>
                        </div>
                        <div class="animal-info-item">
                            <div class="animal-info-icon is-primary"><i class="bi bi-calendar3"></i></div>
                            <div class="animal-info-text">
                                <span class="animal-info-label">Yaş</span>
                                <span class="animal-info-value">@Model.Age yıl</span>
                            </div>
                        </div>
                        <div class="animal-info-item">
                            <div class="animal-info-icon is-secondary"><i class="bi bi-speedometer2"></i></div>
                            <div class="animal-info-text">
                                <span class="animal-info-label">Kilo</span>
                                <span class="animal-info-value">@Model.Weight kg</span>
                            </div>
                        </div>
                        <div class="animal-info-item">
                            <div class="animal-info-icon is-primary"><i class="bi bi-rulers"></i></div>
                            <div class="animal-info-text">
                                <span class="animal-info-label">Boy</span>
                                <span class="animal-info-value">@Model.Height cm</span>
                            </div>
                        </div>
                        <div class="animal-info-item">
                            <div class="animal-info-icon is-info"><i class="bi bi-geo-alt"></i></div>
                            <div class="animal-info-text">
                                <span class="animal-info-label">Şehir</span>
                                <span class="animal-info-value">@Model.City</span>
                            </div>
                        </div>
                    </div>


                    <div class="card-ui animal-photo-url-card" id="photoUrlCard">
                        <div class="card-icon-tile is-primary"><i class="bi bi-link-45deg"></i></div>
                        <div style="flex: 1 1 auto; min-width: 0;">
                            <span class="text-small" style="font-weight: 600;">Fotoğraf Bağlantısı</span>
                            <div class="animal-photo-url-text" id="photoUrlText">@Model.ImageUrl.Substring(0, 50) ...</div>
                        </div>
                        <a href="@Model.ImageUrl" target="_blank" rel="noopener" class="btn-ui btn-ui--ghost btn-ui--sm">
                            <i class="bi bi-box-arrow-up-right"></i> Aç
                        </a>
                    </div>


                    <div class="animal-profile-meta">
                        <span class="animal-profile-meta-item"><i class="bi bi-calendar-plus"></i> Kayıt Tarihi: 12 Mart 2025</span>
                        <span class="animal-profile-meta-item"><i class="bi bi-clock-history"></i> Son Güncelleme: 3 gün önce</span>
                    </div>
                </div>
            </div>

            <div class="card-ui animal-treatments-card">

                <div class="card-header-row">

                    <div style="display: flex; align-items: center; gap: 0.85rem;">

                        <div class="card-icon-tile is-primary">
                            <i class="bi bi-heart-pulse"></i>
                        </div>

                        <div>
                            <h2 class="text-card-title">Son Tedaviler</h2>

                            <p class="text-small text-muted" style="margin-top: 2px;">
                                @Model.Name adlı hayvanın son tedavi kayıtları.
                            </p>
                        </div>

                    </div>

                    <a href="/treatment/index?animalId=@Model.Id"
                       class="link-action">
                        Tümünü Gör
                        <i class="bi bi-arrow-right"></i>
                    </a>

                </div>
                @await Component.InvokeAsync("_AnimalDetailLatestTreatmentsComponentPartial", new { id = Model.Id })

            </div>

            <div class="animal-action-grid">
                <button type="button" class="card-ui card-ui--interactive animal-action-card is-appointment" data-toast="Randevu oluşturma bu prototipte pasif durumdadır.">
                    <div class="card-icon-tile is-info"><i class="bi bi-calendar-plus"></i></div>
                    <div class="animal-action-body">
                        <div class="animal-action-title">Randevu Oluştur</div>
                        <div class="animal-action-subtitle">@Model.Name için yeni randevu alın</div>
                    </div>
                    <a href="/appointment/create"><span class="animal-action-arrow"><i class="bi bi-arrow-right"></i></span></a>
                </button>

                <button type="button" class="card-ui card-ui--interactive animal-action-card is-treatment" data-toast="Tedavi geçmişi bu prototipte pasif durumdadır.">
                    <div class="card-icon-tile is-secondary"><i class="bi bi-capsule"></i></div>
                    <div class="animal-action-body">
                        <div class="animal-action-title">Tedavi Geçmişi</div>
                        <div class="animal-action-subtitle">Tüm tedavi kayıtlarını görüntüleyin</div>
                    </div>
                    <a href="/appointment/create"><span class="animal-action-arrow"><i class="bi bi-arrow-right"></i></span></a>
                </button>

                <button type="button" class="card-ui card-ui--interactive animal-action-card is-payment" data-toast="Ödeme geçmişi bu prototipte pasif durumdadır.">
                    <div class="card-icon-tile is-primary"><i class="bi bi-credit-card-2-back"></i></div>
                    <div class="animal-action-body">
                        <div class="animal-action-title">Ödeme Geçmişi</div>
                        <div class="animal-action-subtitle">Yapılan ödemeleri görüntüleyin</div>
                    </div>
                    <a href="/appointment/create"><span class="animal-action-arrow"><i class="bi bi-arrow-right"></i></span></a>
                </button>
            </div>

            @await Component.InvokeAsync("_AnimalDetailRecentAppointmentsComponentPartial", new { animalId = Model.Id })

        </div>
    </main>

    <div class="animal-toast-stack" id="toastStack" aria-live="polite"></div>

    <script>
            /* ==========================================================================
               JAVASCRIPT — page-specific prototype interactions only.
               No API calls, no backend logic.
               ========================================================================== */

            (function () {
                'use strict';

                /* ---- Graceful image fallback ---- */
                var profileImage = document.getElementById('profileImage');
                var profileMediaFallback = document.getElementById('profileMediaFallback');

                function showFallback() {
                    profileImage.style.display = 'none';
                    profileMediaFallback.style.display = 'flex';
                }

                profileMediaFallback.style.display = 'none';
                profileImage.addEventListener('error', showFallback, { once: true });
                if (!profileImage.getAttribute('src')) showFallback();

                /* ---- Favorite toggle ---- */
                var favoriteBtn = document.getElementById('favoriteBtn');
                favoriteBtn.addEventListener('click', function () {
                    var isActive = favoriteBtn.classList.toggle('is-active');
                    favoriteBtn.setAttribute('aria-pressed', String(isActive));
                });

                /* ---- Lightweight self-contained toast ---- */
                var toastStack = document.getElementById('toastStack');

                function showToast(message) {
                    var toast = document.createElement('div');
                    toast.className = 'animal-toast';
                    toast.setAttribute('role', 'status');
                    toast.innerHTML =
                        '<i class="bi bi-info-circle-fill animal-toast-icon"></i>' +
                        '<span class="animal-toast-message"></span>';
                    toast.querySelector('.animal-toast-message').textContent = message;
                    toastStack.appendChild(toast);

                    var timer = setTimeout(function () { dismissToast(toast); }, 3200);
                    toast.dataset.timer = timer;
                }

                function dismissToast(toast) {
                    if (!toast || toast.classList.contains('is-leaving')) return;
                    clearTimeout(toast.dataset.timer);
                    toast.classList.add('is-leaving');
                    toast.addEventListener('animationend', function () { toast.remove(); }, { once: true });
                }

                /* ---- Action cards ---- */
                document.querySelectorAll('[data-toast]').forEach(function (el) {
                    el.addEventListener('click', function () {
                        showToast(el.getAttribute('data-toast'));
                    });
                });

                document.getElementById('editNoteBtn').addEventListener('click', function () {
                    showToast('Not düzenleme bu prototipte pasif durumdadır.');
                });


            })();
    </script>
}